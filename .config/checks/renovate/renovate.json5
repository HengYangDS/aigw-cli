{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // Only the operator-selected maintenance runner creates proposals. Forge
  // files are projections, so their native dependency managers are not owners.
  enabledManagers: ["gomod", "npm", "mise", "custom.regex"],
  // Dependency truth is authored here; temporary checkouts are not inputs.
  includePaths: [
    "go.mod",
    "go.sum",
    ".config/mise/config.toml",
    ".config/mise/mise.lock",
    "package.json",
    "package-lock.json",
    ".config/npm/npmrc",
    ".config/ci/pipeline.cue",
  ],
  baseBranchPatterns: ["dev"],
  branchPrefix: "proposal/dependencies/",
  dependencyDashboard: { enabled: false },
  prConcurrentLimit: 1,
  branchConcurrentLimit: 1,
  semanticCommits: "enabled",
  semanticCommitType: "build",
  semanticCommitScope: "deps",

  ignoreUnstable: true,
  // The repository's release age, declared once and in hours: how old a
  // stable release must be before a proposal takes it, whatever its source.
  // Zero takes it at publication. To hold releases longer, change this one
  // value; no rule below declares an age of its own. With an age above zero,
  // a release whose registry publishes no time stays held.
  minimumReleaseAge: "0 hours",
  minimumReleaseAgeBehaviour: "timestamp-required",
  internalChecksFilter: "strict",
  prCreation: "immediate",
  rangeStrategy: "pin",
  osvVulnerabilityAlerts: true,
  // Security fixes skip the release age, not signatures, current-commit
  // tests, or Change admission.
  vulnerabilityAlerts: {
    minimumReleaseAge: "0 hours",
    groupName: null,
    automerge: false,
    vulnerabilityFixStrategy: "highest",
  },
  // Transitive releases move only with a lock refresh. Proposing it keeps the
  // candidate calculation complete under the same release age.
  // Renovate's default would hold it until Monday morning, so it names its
  // own schedule: the release age alone decides when a release may move.
  lockFileMaintenance: {
    enabled: true,
    schedule: ["at any time"],
  },

  // A supported fast-forward preserves the locally signed Git object. A
  // platform that cannot provide it must use the maintainer publication path.
  automerge: false,
  automergeType: "pr",
  automergeStrategy: "fast-forward",
  platformAutomerge: false,
  packageRules: [
    {
      matchManagers: ["gomod", "mise"],
      matchDepNames: ["go"],
      groupName: "Go toolchain",
    },
    {
      matchManagers: ["npm"],
      matchUpdateTypes: ["minor", "patch"],
      matchCurrentVersion: ">=1.0.0",
      groupName: "repository tools",
      automerge: true,
    },
    {
      matchManagers: ["gomod"],
      matchUpdateTypes: ["minor", "patch"],
      matchDepTypes: ["require"],
      matchCurrentVersion: ">=1.0.0",
      groupName: "Go dependencies",
      automerge: true,
    },
  ],

  customManagers: [
    // The CUE keys name the native clients, so each rule names its package.
    {
      customType: "regex",
      description: "Pinned Codex release of the native clients in the CUE authority",
      managerFilePatterns: ["/^\\.config/ci/pipeline\\.cue$/"],
      matchStrings: ['\\n\\tcodex:\\s+"(?<currentValue>\\d+\\.\\d+\\.\\d+(?:-[\\w.-]+)?)"'],
      depNameTemplate: "@openai/codex",
      datasourceTemplate: "npm",
      versioningTemplate: "npm",
    },
    {
      customType: "regex",
      description: "Pinned Claude Code release of the native clients in the CUE authority",
      managerFilePatterns: ["/^\\.config/ci/pipeline\\.cue$/"],
      matchStrings: ['\\n\\tclaude:\\s+"(?<currentValue>\\d+\\.\\d+\\.\\d+(?:-[\\w.-]+)?)"'],
      depNameTemplate: "@anthropic-ai/claude-code",
      datasourceTemplate: "npm",
      versioningTemplate: "npm",
    },
    {
      customType: "regex",
      description: "Pinned Hermes release commit of the native clients in the CUE authority",
      managerFilePatterns: ["/^\\.config/ci/pipeline\\.cue$/"],
      matchStrings: [
        '\\n\\thermes:\\s*\\{\\s*commit:\\s+"(?<currentDigest>[a-f0-9]{40})"\\s*//\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+)',
      ],
      depNameTemplate: "NousResearch/hermes-agent",
      datasourceTemplate: "github-tags",
      // Release tags only: semver coercion would accept canary tags such as
      // v0.23.1+canary.20261110T064422Z as releases. At most three major digits
      // keep the publisher's calendar tags, such as v2026.9.24, out as well.
      versioningTemplate: "regex:^v(?<major>\\d{1,3})\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
    },
    {
      customType: "regex",
      description: "Pinned GitHub Actions in the CUE authority",
      managerFilePatterns: ["/^\\.config/ci/pipeline\\.cue$/"],
      matchStrings: [
        '"(?<depName>[\\w.-]+/[\\w.-]+)@(?<currentDigest>[a-f0-9]{40})"\\s*//\\s*(?<currentValue>v[\\d.]+)',
      ],
      datasourceTemplate: "github-tags",
      versioningTemplate: "github-actions",
    },
    {
      customType: "regex",
      description: "Pinned container images in their declared authorities",
      managerFilePatterns: ["/^\\.config/ci/pipeline\\.cue$/", "/^\\.config/mise/config\\.toml$/"],
      matchStrings: [
        '"(?<depName>(?:ghcr|docker)\\.io/[\\w./-]+)(?::(?<currentValue>[\\w.-]+))?@(?<currentDigest>sha256:[a-f0-9]{64})"',
      ],
      datasourceTemplate: "docker",
      versioningTemplate: "docker",
    },
  ],
}
