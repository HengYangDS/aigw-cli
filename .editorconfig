root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab
indent_size = tab

# Expected bytes of the Hermes projection: a case keeps an operator's trailing spaces.
[internal/adapter/hermes/testdata/projection-bytes/**.golden]
trim_trailing_whitespace = false
