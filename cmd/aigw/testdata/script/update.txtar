# update refuses a source build without a release source and a rollback
# without a retained program, and reports a current release from a
# configured source, in text and as JSON. A preview without a release source
# continues with a preview.
exec aigw update --help
cmp stdout help.txt

exitcode 1 aigw update
cmp stdout unconfigured.txt
exitcode 1 aigw update --rollback
cmp stdout rollback.txt
exitcode 1 aigw update --json
cmp stdout unconfigured.json
exitcode 1 aigw update --dry-run
cmp stdout unconfigured-preview.txt

env AIGW_GITHUB_RELEASE_ORIGIN=$UPSTREAM
env AIGW_GITHUB_RELEASE_REPOSITORY=team/aigw
exec aigw update
cmp stdout current.txt
exec aigw update --json
cmp stdout current.json
snapshot $BIN before.txt
exec aigw update --dry-run --json
normalize stdout preview.out
[!windows] cmp preview.out preview.json
[windows] cmp preview.out preview-windows.json
snapshot $BIN after.txt
cmp after.txt before.txt
exitcode 1 aigw update --dry-run --rollback
cmp stdout rollback-preview.txt

-- preview.json --
{
  "schema_version": 1,
  "ok": true,
  "dry_run": true,
  "state": "current",
  "version": "0.1.0-dev",
  "summary": "v0.1.0-dev is already the current version",
  "next_action": "aigw sync",
  "current_version": "0.1.0-dev",
  "path": "$BIN/aigw"
}
-- preview-windows.json --
{
  "schema_version": 1,
  "ok": true,
  "dry_run": true,
  "state": "current",
  "version": "0.1.0-dev",
  "summary": "v0.1.0-dev is already the current version",
  "next_action": "aigw sync",
  "current_version": "0.1.0-dev",
  "path": "$BIN\\aigw.exe"
}
-- rollback-preview.txt --
AIGW  Action required
────────────────────────────────────────

Problem
  if any flags in the group [dry-run rollback] are set none of the others can be; [dry-run rollback] were all set; run `aigw update --help`

Fix
  aigw update --help
-- help.txt --
AIGW  aigw update
────────────────────────────────────────
  Replace only a portable AIGW program; Homebrew-managed copies must be
  upgraded with Homebrew. Client settings and Tokens do not change.
  Run aigw sync, then aigw check before resuming clients. --rollback
  restores the retained program, not configuration. An incompatible
  current configuration blocks program rollback without changing files.
  Before Homebrew installs an earlier release, --rollback returns macOS
  Keychain items to that release's reader.

Usage
  aigw update [flags]

Options
      --candidate string   Install one local portable archive without network access
      --checksums string   Checksum manifest for --candidate
      --dry-run            Show the version that an update would install, from public release metadata or the --candidate archive's name, without downloading or writing anything
  -h, --help               help for update
      --json               Write the program transition as JSON
      --rollback           Roll back the portable AIGW program to the previous version offline
-- unconfigured.txt --
AIGW  Action required
────────────────────────────────────────

Problem
  release source is not configured; install an official release or use `aigw update --candidate <archive> --checksums <checksums>`

Fix
  aigw update --candidate <archive> --checksums <checksums>
-- rollback.txt --
AIGW  Action required
────────────────────────────────────────

Problem
  Program rollback did not complete

Evidence
  AIGW could not activate the retained previous program.

Impact
  No previous program version was confirmed active.

Fix
  aigw installation
-- current.txt --
AIGW  Update
────────────────────────────────────────
  ✓ already running the latest version v0.1.0-dev
  Run the active version's sync command to reconcile owned client settings, then check readiness.

Next
  aigw sync
-- unconfigured.json --
{
  "schema_version": 3,
  "ok": false,
  "error": "release source is not configured; install an official release or use `aigw update --candidate \u003carchive\u003e --checksums \u003cchecksums\u003e`",
  "next_detail": "aigw update --candidate \u003carchive\u003e --checksums \u003cchecksums\u003e"
}
-- current.json --
{
  "schema_version": 1,
  "ok": true,
  "state": "current",
  "version": "0.1.0-dev",
  "summary": "already running the latest version v0.1.0-dev",
  "next_action": "aigw sync"
}
-- unconfigured-preview.txt --
AIGW  Action required
────────────────────────────────────────

Problem
  Update preview did not complete

Evidence
  AIGW could not determine the version that an update would install.

Impact
  No file, rollback copy or Keychain item changed.

Fix
  aigw update --dry-run --candidate <archive> --checksums <checksums>
