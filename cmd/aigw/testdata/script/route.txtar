# route adds a Route to an Account, lists and shows Routes as JSON, and
# refuses to remove a Route that a client selects. Adding, editing and removing
# a Route also write JSON.
exec aigw route --help
cmp stdout help.txt

stdin token.txt
exec aigw add team --label 'Team Gateway' --anthropic-url $UPSTREAM --model team-model --for claude --token-stdin
exec aigw route add spare --account team --model spare-model --protocol anthropic
cmp stdout added.txt
exec aigw route list --json
cmp stdout routes.json
exec aigw route show spare --json
normalize stdout spare.out
cmp spare.out spare.json

exitcode 1 aigw route remove team
cmp stdout refusal.txt
exitcode 1 aigw route show missing --json
cmp stdout missing.json

exec aigw route add third --account team --model third-model --upstream-model third-wire --protocol anthropic --purpose 'Long tasks' --json
cmp stdout third.json
exitcode 1 aigw route add third --account team --model third-model --protocol anthropic --json
cmp stdout exists.json
exec aigw route edit third --label 'Third Route' --json
cmp stdout edited.json
exitcode 1 aigw route edit missing --label 'Missing' --json
cmp stdout unknown.json
exec aigw route remove third --json
cmp stdout removed.json
exitcode 1 aigw route remove team --json
cmp stdout selected.json

-- token.txt --
sk-team-token-0001
-- help.txt --
AIGW  aigw route
────────────────────────────────────────
  Manage Routes

Usage
  aigw route [command]

Commands
  add                  Add a model route to an existing account
  edit                 Update route display metadata
  list                 List Routes
  remove               Remove an unused route
  rename               Rename a route
  show                 Show secret-free route metadata

Options
  -h, --help   help for route
-- added.txt --
AIGW  Model route added
────────────────────────────────────────
  Route                spare
  Account              team
  Model                spare-model
  ✓ Reused the existing Account; no client selection was changed

Next
  aigw use --for <client> spare
