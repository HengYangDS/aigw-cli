# setup asks in a terminal, or applies a team file: a preview, Token input for
# one provider, a refused Token, a rerun on a configured home with what stays
# local, pruning, deferred and empty Tokens, and the refusals of a team file
# that sets clients, has another version or cannot be read.
exec aigw setup --help
cmp stdout help.txt

# Guided setup asks in a terminal; without one, or with --json or --dry-run,
# it names a team file instead.
mkdir $WORK/guided
env HOME=$WORK/guided USERPROFILE=$WORK/guided XDG_CONFIG_HOME=$WORK/guided XDG_DATA_HOME=$WORK/guided APPDATA=$WORK/guided LOCALAPPDATA=$WORK/guided
exitcode 1 aigw setup
cmp stdout guided-no-terminal.txt
exitcode 1 aigw setup --json
cmp stdout guided-json.json
cp stdout guided-json.out
exitcode 1 aigw setup --dry-run --json
cmp stdout guided-dry-run.json
cp stdout guided-dry-run.out
# In a terminal it adds a provider, and with no installed client that speaks
# its protocol it stops, naming the client list, which runs here.
[!windows] envsubst guided-none.in guided-none-input.txt
[!windows] ttyin -stdin guided-none-input.txt
[!windows] exec aigw setup
# Each prompt ends in a space, where the answer goes, which the patterns
# spell as \x20.
[!windows] stdout '^Provider ID \(for example, dmxapi\): Provider name: Endpoint protocol:\x20\n  1\. Anthropic Messages\n  2\. OpenAI Responses\n  3\. OpenAI Chat Completions\nSelect \[1\]: OpenAI Responses URL: Paste the Team Gateway Token:\x20\n'
[!windows] stdout '^AIGW  Setup stopped before a model$'
[!windows] stdout '^  Provider             Team Gateway \(team\), added$'
[!windows] stdout '^  ✓ Token              Accepted by the provider and stored$'
[!windows] stdout '^  · Installed clients  None that speaks a protocol for which provider team has an endpoint$'
[!windows] stdout '^  ✓ Install a client, then run `aigw setup` again to choose it and a model$'
[!windows] stdout '^Next\n  aigw client list$'
[!windows] exec aigw client list

# With Claude Code installed it saves the provider, the client and a model of
# the catalog, then checks the client. Claude Desktop's presence depends on
# the host, so Enter takes the first choice of whichever prompts appear.
mkdir $WORK/guided-client
env HOME=$WORK/guided-client USERPROFILE=$WORK/guided-client XDG_CONFIG_HOME=$WORK/guided-client XDG_DATA_HOME=$WORK/guided-client APPDATA=$WORK/guided-client LOCALAPPDATA=$WORK/guided-client
[!windows] envsubst guided.in guided-input.txt
[!windows] ttyin -stdin guided-input.txt
[!windows] exec aigw setup
[!windows] stdout 'Setup saved'
[!windows] stdout 'Provider +Team Gateway \(team\), added'
[!windows] stdout 'Token +Accepted by the provider and stored'
[!windows] stdout 'Claude +team/spare-model on Anthropic Messages'
[!windows] stdout 'Check'
# It runs again: it offers the provider beside a new one, and keeps its Token.
[!windows] ttyin -stdin guided-again.txt
[!windows] exec aigw setup
[!windows] stdout '1\. Team Gateway \(team\)\n +2\. Add a new provider'
[!windows] stdout 'Provider +Team Gateway \(team\), kept as it was'
[!windows] stdout 'Token +Stored before'
[!windows] stdout 'Claude +team/spare-model on Anthropic Messages'
# Each refusal's fix, a team file, runs here; guided setup itself still needs
# a terminal.
envsubst team.in team.toml
exec aigw setup --from team.toml --dry-run --json
fixloop -input -did 'previewed a team file with aigw setup --from team.toml --dry-run' guided-dry-run.out aigw setup --dry-run --json
exec aigw setup --from team.toml --json
fixloop -input -did 'applied a team file with aigw setup --from team.toml --json' guided-json.out aigw setup --json

# Without a terminal or with --json, a named provider without a stored Token
# needs its Token from --token-stdin, which the fix pipes; then the same
# command uses the stored Token.
mkdir $WORK/stored
env HOME=$WORK/stored USERPROFILE=$WORK/stored XDG_CONFIG_HOME=$WORK/stored XDG_DATA_HOME=$WORK/stored APPDATA=$WORK/stored LOCALAPPDATA=$WORK/stored
[darwin] env CONF=$HOME/Library/Application' 'Support/aigw
[!darwin] env CONF=$HOME/aigw
envsubst team.in team.toml
exitcode 1 aigw setup --from team.toml --provider team --json
normalize stdout named-without-input.out
cmp named-without-input.out named-without-input.json
stdin token.txt
fixloop stdout aigw setup --from team.toml --provider team --json
stdout '"provider": "team",\n\s+"state": "present"'
# A Token that an earlier setup or release stored for a provider that the
# configuration does not name is used without a prompt, and setup says so:
# guided setup adds the provider, and a team file names it, without a
# terminal and in one.
rm $CONF/aigw.toml
[!windows] envsubst guided-stored.in guided-stored-input.txt
[!windows] ttyin -stdin guided-stored-input.txt
[!windows] exec aigw setup
[!windows] ! stdout 'Paste the'
[!windows] stdout 'Provider +Team Gateway \(team\), added'
[!windows] stdout 'Token +Already stored; used without a prompt'
[!windows] ! stdout 'sk-team-token'
rm $CONF/aigw.toml
exec aigw setup --from team.toml --provider team
stdout '✓ team +Already stored; used without a prompt'
! stdout 'sk-team-token'
rm $CONF/aigw.toml
# A prompt would read the one empty line as an empty Token, which fails.
[!windows] ttyin -stdin enter.txt
[!windows] exec aigw setup --from team.toml --provider team
[!windows] ! stdout 'Paste the'
[!windows] stdout '✓ team +Already stored; used without a prompt'

# Team setup: a preview reads no Token and writes nothing.
mkdir $WORK/second
env HOME=$WORK/second USERPROFILE=$WORK/second XDG_CONFIG_HOME=$WORK/second XDG_DATA_HOME=$WORK/second APPDATA=$WORK/second LOCALAPPDATA=$WORK/second
envsubst team.in team.toml
snapshot $HOME second-before.txt
# The credential reader's path differs by platform.
exec aigw setup --from team.toml --dry-run --json
normalize stdout team-preview.out '\$HOME[^"\n]*credential[^"\n]*'
cmp team-preview.out team-preview.json
exec aigw setup --from team.toml --dry-run
normalize stdout team-preview-text.out '\$HOME[^"\n]*credential[^"\n]*'
cmp team-preview-text.out team-preview.txt
snapshot $HOME second-after.txt
cmp second-after.txt second-before.txt

# A provider that the team file adds needs the endpoint of each protocol
# that its models declare, before anything is written.
envsubst fresh-chat.in fresh-chat.toml
exitcode 1 aigw setup --from fresh-chat.toml --json
normalize stdout fresh-chat.out
cmp fresh-chat.out fresh-chat.json
envsubst fresh-chat-fixed.in fresh-chat.toml
fixloop -did 'gave provider fresh its chat endpoint in the team file' stdout aigw setup --from fresh-chat.toml --dry-run --json

# Token input belongs to one provider, before anything is read.
exitcode 1 aigw setup --from team.toml --provider team --provider spare --token-stdin --json
normalize stdout two-providers.out
cmp two-providers.out two-providers.json
fixloop -input stdout aigw setup --from team.toml --provider team --provider spare --token-stdin --json
exitcode 1 aigw setup --prune --json
normalize stdout prune-alone.out
cmp prune-alone.out prune-alone.json
fixloop -input stdout aigw setup --prune --json

# A Token that the provider rejects refuses the whole apply.
stdin rejected.txt
exitcode 1 aigw setup --from team.toml --provider team --token-stdin --json
normalize stdout team-rejected.out
cmp team-rejected.out team-rejected.json
[darwin] ! exists $HOME/'Library/Application Support/aigw/aigw.toml'
[darwin] ! exists $HOME/'Library/Application Support/aigw/secrets/tokens/team'
[!darwin] ! exists $HOME/aigw/aigw.toml
[!darwin] ! exists $HOME/aigw/secrets/tokens/team
stdin token.txt
fixloop -did 'piped a Token that the provider accepts' stdout aigw setup --from team.toml --provider team --token-stdin --json
normalize stdout team-connected.out
cmp team-connected.out team-connected.json

# Setup runs again: the file's models, families and recommendations win, an
# existing provider keeps its endpoints and Token, and no selection changes.
envsubst again.in again.toml
exec aigw setup --from again.toml --dry-run --json
normalize stdout again-preview.out '\$HOME[^"\n]*credential[^"\n]*'
cmp again-preview.out again-preview.json
exec aigw setup --from again.toml --json
normalize stdout again.out
cmp again.out again.json
exec aigw setup --from again.toml
normalize stdout again-text.out
cmp again-text.out again.txt
exec aigw model show team/team-model --json
stdout '"label": "Team Gateway Again · Team Model Again"'
exec aigw status --json
stdout '"claude": \{\n\s+"state": "configured"'
exec aigw setup --from again.toml --prune --json
normalize stdout pruned.out
cmp pruned.out pruned.json
# A file whose model would take the protocol of Claude's selection keeps the
# local model, and a differing balance probe stays local.
envsubst away.in away.toml
exec aigw setup --from away.toml --json
normalize stdout away.out
cmp away.out away.json

# Without a terminal, a provider that a recommendation needs waits for its
# Token, and an empty stored Token is none; its fix stores one.
mkdir $WORK/deferred
env HOME=$WORK/deferred USERPROFILE=$WORK/deferred XDG_CONFIG_HOME=$WORK/deferred XDG_DATA_HOME=$WORK/deferred APPDATA=$WORK/deferred LOCALAPPDATA=$WORK/deferred
exec aigw setup --from team.toml --json
normalize stdout deferred.out
cmp deferred.out deferred.json
stdin token.txt
exec aigw provider rotate team --token-stdin
[darwin] exists $HOME/'Library/Application Support/aigw/secrets/tokens/team'
[darwin] cp empty-file $HOME/'Library/Application Support/aigw/secrets/tokens/team'
[!darwin] exists $HOME/aigw/secrets/tokens/team
[!darwin] cp empty-file $HOME/aigw/secrets/tokens/team
exec aigw setup --from team.toml --json
normalize stdout deferred-empty.out
cmp deferred-empty.out deferred-empty.json
# Status finds the empty Token no more than it finds the missing one, and
# names the fix that stores one; once a Token is stored, the team file applies
# again, which selects the recommended model.
exec aigw status
stdout '(?m)^  aigw provider rotate team$'
stdin token.txt
exec aigw provider rotate team --token-stdin
exec aigw status
stdout '(?m)^  aigw setup --from <file>$'
! stdout 'provider rotate'
exec aigw setup --from team.toml --json
stdout '"state": "stored"|"state": "present"'
stdout '"id": "claude",\n\s+"state": "configured"'

# A team file that sets clients, or of another version, is refused.
exitcode 1 aigw setup --from clients.toml --json
normalize stdout clients-refusal.out
cmp clients-refusal.out clients-refusal.json
cp team.toml clients.toml
fixloop -did 'removed the [clients] section from the team file' stdout aigw setup --from clients.toml --json
exitcode 1 aigw setup --from old.toml --json
normalize stdout old-refusal.out
cmp old-refusal.out old-refusal.json
cp team.toml old.toml
fixloop -did 'used the team file of version 8 that aigw config export wrote' stdout aigw setup --from old.toml --json

# A team file that cannot be applied names the entry of the file to change,
# never `aigw check`, which would not read the file. The fix is an edit of
# the file, so fixloop has no command to rerun.
exitcode 1 aigw setup --from undefined-field.toml --json
stdout '"next_detail": "Correct the field `providers.bogus` on line 5 in the team file, then run the same command again."'
! stdout 'aigw check'
exitcode 1 aigw setup --from credential-field.toml --json
stdout '"next_detail": "Correct the field `providers.token` in the team file, then run the same command again."'
exitcode 1 aigw setup --from bad-provider.toml --json
stdout '"next_detail": "Correct provider `A b` in the team file, then run the same command again."'
exitcode 1 aigw setup --from bad-model.toml --json
stdout '"next_detail": "Correct model `a/m` in the team file, then run the same command again."'
exitcode 1 aigw setup --from bad-family.toml --json
stdout '"next_detail": "Correct family `f` in the team file, then run the same command again."'
exitcode 1 aigw setup --from bad-recommendation.toml --json
stdout '"next_detail": "Correct the `codex` recommendation in the team file, then run the same command again."'
exitcode 1 aigw setup --from unknown-model.toml --json
stdout '"next_detail": "Correct the `codex` recommendation in the team file, then run the same command again."'
exitcode 1 aigw setup --from no-endpoint.toml --json
stdout '"next_detail": "Correct model `a/m` in the team file, then run the same command again."'
! stdout 'aigw check'

# A team file that cannot be read names the one classification and its fix.
exitcode 1 aigw setup --from missing.toml --json
normalize stdout missing.out
cmp missing.out missing.json
cp team.toml missing.toml
fixloop -did 'named a team file that exists' stdout aigw setup --from missing.toml --json
exitcode 1 aigw setup --from team.toml/team.toml --json
normalize stdout in-the-way.out
cmp in-the-way.out in-the-way.json
# Its fix names another team file, so the same command still fails.
fixloop -input -did 'named a team file that exists' stdout aigw setup --from team.toml/team.toml --json
symlink dangling.toml -> nowhere.toml
exitcode 1 aigw setup --from dangling.toml --json
normalize stdout dangling.out
cmp dangling.out dangling.json
cp team.toml nowhere.toml
fixloop -did 'named a team file that exists' stdout aigw setup --from dangling.toml --json
[!windows] [!root] cp team.toml unreadable.toml
[!windows] [!root] chmod 000 unreadable.toml
[!windows] [!root] exitcode 1 aigw setup --from unreadable.toml --json
[!windows] [!root] normalize stdout unreadable.out
[!windows] [!root] cmp unreadable.out unreadable.json
[!windows] [!root] chmod 600 unreadable.toml
[!windows] [!root] fixloop -did 'made the team file readable' stdout aigw setup --from unreadable.toml --json

# A label that model edit set locally is replaced by the team file, so the
# preview and the run name it, and the second preview has nothing to change.
exec aigw model edit team/team-model --label 'Local Label'
exec aigw setup --from team.toml --dry-run --json
stdout '"changed_labels": \[\n\s+\{\n\s+"model": "team/team-model",\n\s+"local": "Local Label"\n\s+\}'
exec aigw setup --from team.toml --dry-run
stdout '(?m)^Model labels$'
stdout 'team/team-model +Local Label becomes none'
exec aigw setup --from team.toml --json
stdout '"changed_labels"'
exec aigw setup --from team.toml --dry-run --json
! stdout 'changed_labels'


-- rejected.txt --
sk-rejected-token
-- token.txt --
sk-team-token-0001
-- help.txt --
AIGW  aigw setup
────────────────────────────────────────
  Without --from, ask in a terminal for a provider, an installed client and a model from the
  provider's catalog, save them, and check the client; it can run again. With --from, apply a
  team file: its models, families and recommendations win, and an existing provider keeps its
  endpoints and Token.

Usage
  aigw setup [flags]

Examples
  aigw setup
  aigw setup --from team.toml --dry-run
  aigw setup --from team.toml --provider dmxapi --token-stdin

Options
      --dry-run[=true|false]       Show what setup would change without reading a Token or writing anything
      --from string                Apply a team file: its providers, models, families and recommendations
  -h, --help[=true|false]          help for setup
      --json[=true|false]          Write the setup result as JSON
      --provider stringArray       With --from, a provider whose Token to read, at a prompt or from --token-stdin, unless one is stored; repeatable
      --prune[=true|false]         With --from, remove the local models that no client selects and no recommendation names, and unused families
      --token-stdin[=true|false]   With --from, read the one --provider's Token from standard input
-- team.in --
version = 8

[[providers]]
id = "spare"
label = "Spare Gateway"
endpoints = {anthropic = "$UPSTREAM/spare"}

[[providers.models]]
id = "spare-model"
family = "team-model"
protocols = {anthropic = []}

[[providers]]
id = "team"
label = "Team Gateway"
endpoints = {anthropic = "$UPSTREAM"}

[[providers.models]]
id = "team-model"
family = "team-model"
protocols = {anthropic = ["text"]}

[[families]]
id = "team-model"
label = "Team Model"

[recommendations.claude]
primary = {model = "team/team-model"}
-- again.in --
version = 8

[[providers]]
id = "team"
label = "Team Gateway Again"
balance = {kind = "dmxapi", base_url = "$UPSTREAM"}
endpoints = {anthropic = "$UPSTREAM/elsewhere", responses = "$UPSTREAM/v1"}

[[providers.models]]
id = "team-model"
family = "team-model"
protocols = {anthropic = ["text", "tool_search"], responses = [], chat = []}

[[families]]
id = "team-model"
label = "Team Model Again"

[recommendations.claude]
primary = {model = "team/team-model"}

[recommendations.hermes]
primary = {model = "team/team-model", protocol = "chat"}
-- away.in --
version = 8

[[providers]]
id = "team"
label = "Team Gateway Again"
balance = {kind = "dmxapi", base_url = "$UPSTREAM/elsewhere"}
endpoints = {anthropic = "$UPSTREAM", responses = "$UPSTREAM/v1"}

[[providers.models]]
id = "team-model"
family = "team-model"
protocols = {responses = []}

[[families]]
id = "team-model"
label = "Team Model Again"
-- fresh-chat.in --
version = 8

[[providers]]
id = "fresh"
label = "Fresh"
endpoints = {anthropic = "$UPSTREAM/fresh"}

[[providers.models]]
id = "fresh-chat"
family = "fresh-chat"
protocols = {chat = []}
-- fresh-chat-fixed.in --
version = 8

[[providers]]
id = "fresh"
label = "Fresh"
endpoints = {anthropic = "$UPSTREAM/fresh", chat = "$UPSTREAM/fresh/v1"}

[[providers.models]]
id = "fresh-chat"
family = "fresh-chat"
protocols = {chat = []}
-- fresh-chat.json --
{
  "schema_version": 3,
  "ok": false,
  "error": "the team file declares fresh/fresh-chat on OpenAI Chat Completions, and provider fresh, which the file adds, has no OpenAI Chat Completions endpoint",
  "impact": "Nothing changed.",
  "next_detail": "Correct model `fresh/fresh-chat` in the team file, then run the same command again."
}
-- clients.toml --
version = 8

[[providers]]
id = "team"
label = "Team Gateway"
endpoints = {anthropic = "https://team.invalid"}

[clients.claude]
enabled = false
model = "team/team-model"
-- old.toml --
version = 7
[accounts.team]
label = "Team Gateway"
[accounts.team.endpoints]
anthropic = "https://team.invalid"
