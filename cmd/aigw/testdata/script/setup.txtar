openai_responses = "$UPSTREAM/v1"
[accounts.team.account_probe]
kind = "dmxapi"
base_url = "$UPSTREAM"
[models.team-model]
label = "Team Model Again"
[routes.team-route]
account = "team"
model = "team-model"
upstream_model = "team-model"
interfaces = { anthropic = ["text", "tool_search"] }
[routes.team-responses]
