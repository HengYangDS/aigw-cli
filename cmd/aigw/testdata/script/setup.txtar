version = 7
[recommendations.claude.primary]
route = "team-route"
[accounts.team]
label = "Team Gateway"
[accounts.team.endpoints]
anthropic = "$UPSTREAM"
[accounts.spare]
label = "Spare Gateway"
[accounts.spare.endpoints]
anthropic = "$UPSTREAM/spare"
[models.team-model]
label = "Team Model"
[routes.team-route]
account = "team"
model = "team-model"
upstream_model = "team-model"
interfaces = { anthropic = ["text"] }
[routes.spare-route]
account = "spare"
model = "team-model"
upstream_model = "spare-model"
interfaces = { anthropic = [] }
