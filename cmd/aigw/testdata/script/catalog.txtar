      },
      "secret_available": true,
      "status": "ok",
      "models": [
        {
          "id": "team-model",
          "state": "admitted",
          "routes": [
            {
              "id": "team",
              "model": "team-model",
              "upstream_model": "team-model",
              "capabilities": [],
              "lifecycle": "admitted",
              "evidence": "observed"
            }
          ]
        },
        {
          "id": "spare-model",
          "state": "candidate"
        }
      ],
      "missing_routes": []
    }
  ]
}
-- empty.json --
{
  "observations": []
}
-- refusal.json --
{
  "ok": false,
  "error": "unknown command \"extra\"",
  "impact": "The command could not finish; inspect current state before retrying.",
  "next_action": "aigw --help"
}
