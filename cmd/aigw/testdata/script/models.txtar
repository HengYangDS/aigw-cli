# models refuses an empty home, then compares the configured models with
# the provider's catalog.
exec aigw models --help
cmp stdout help.txt

exitcode 1 aigw models
cmp stdout empty.txt

stdin token.txt
exec aigw add team --label 'Team Gateway' --anthropic-url $UPSTREAM --upstream-model team-model --for claude --token-stdin
exec aigw models
cmp stdout models.txt

exec aigw models --json
cmp stdout models.json
exitcode 1 aigw models extra --json
cmp stdout json-refusal.json

-- token.txt --
sk-team-token-0001
-- help.txt --
AIGW  aigw models
────────────────────────────────────────
  Compare configured model IDs with provider catalogs; does not test inference

Usage
  aigw models [flags]

Options
  -h, --help   help for models
      --json   Write each Route's catalog membership as JSON
-- empty.txt --
AIGW  Action required
────────────────────────────────────────

Problem
  not configured; run `aigw setup`

Impact
  The command could not finish; inspect current state before retrying.

Recommended action
  aigw setup
-- models.txt --
AIGW  Configured model catalog
────────────────────────────────────────
  Catalog membership does not prove protocol capabilities, inference, or client readiness.

Routes
  · Route  team
    team-model · Anthropic Messages · Listed · account team

Next
  aigw use
-- models.json --
{
  "schema_version": 1,
  "ok": true,
  "routes": [
    {
      "route": "team",
      "account": "team",
      "protocol": "anthropic",
      "model": "team-model",
      "upstream_model": "team-model",
      "catalog": "listed"
    }
  ],
  "next_detail": "aigw use --for \u003cclient\u003e \u003croute\u003e"
}
-- json-refusal.json --
{
  "schema_version": 2,
  "ok": false,
  "error": "unknown command \"extra\"",
  "impact": "The command could not finish; inspect current state before retrying.",
  "next_action": "aigw --help"
}
