# account lists Accounts as JSON and in text, edits a label, and refuses to
# rename an unknown Account.
exec aigw account --help
cmp stdout help.txt

stdin token.txt
exec aigw add team --label 'Team Gateway' --anthropic-url $UPSTREAM --model team-model --for claude --token-stdin
exec aigw account list --json
normalize stdout accounts.out
cmp accounts.out accounts.json
exec aigw account edit team --label 'Renamed Gateway'
cmp stdout edited.txt
exec aigw account list
normalize stdout list.out
cmp list.out list.txt

exitcode 1 aigw account rename missing other
cmp stdout refusal.txt
exitcode 1 aigw account rename missing other --json
cmp stdout refusal.json

-- token.txt --
sk-team-token-0001
-- help.txt --
AIGW  aigw account
────────────────────────────────────────
  Manage account endpoints and optional precise diagnostics

Usage
  aigw account [command]

Commands
  diagnostics          Manage optional precise provider diagnostics
  edit                 Update account metadata and protocol endpoints
  list                 List account endpoints without credential values
  rename               Rename an account and update its route references

Options
  -h, --help   help for account
-- accounts.json --
{
  "accounts": [
    {
      "id": "team",
      "label": "Team Gateway",
      "endpoints": {
        "anthropic": "$UPSTREAM"
      }
    }
  ]
}
-- edited.txt --
AIGW  Account updated
────────────────────────────────────────
  Account              team
  ✓ Routes using this account now use the same endpoints; token was not changed

Next
  aigw check
-- list.txt --
AIGW  Accounts
────────────────────────────────────────

Configured endpoints
  team                 Renamed Gateway

Next
  aigw route list
-- refusal.txt --
AIGW  Action required
────────────────────────────────────────

Problem
  Unknown account "missing"

Impact
  The command could not finish; inspect current state before retrying.

Recommended action
  aigw check
-- refusal.json --
{
  "ok": false,
  "error": "Unknown account \"missing\"",
  "impact": "The command could not finish; inspect current state before retrying.",
  "next_action": "aigw check"
}
