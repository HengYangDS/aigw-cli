# account lists Accounts as JSON and in text, edits a label, previews a rename
# and refuses to rename an unknown Account. Its edits and diagnostics also
# write JSON.
exec aigw account --help
cmp stdout help.txt

stdin token.txt
exec aigw add team --label 'Team Gateway' --anthropic-url $UPSTREAM --upstream-model team-model --for claude --token-stdin
exec aigw account list --json
normalize stdout accounts.out
cmp accounts.out accounts.json
exitcode 1 aigw account list extra --json
cmp stdout list-refusal.json
exec aigw account edit team --label 'Renamed Gateway'
cmp stdout edited.txt
exec aigw account list
normalize stdout list.out
cmp list.out list.txt

exitcode 1 aigw account rename missing other
cmp stdout refusal.txt
exitcode 1 aigw account rename missing other --json
cmp stdout refusal.json
snapshot $HOME rename-before.txt
exec aigw account rename team crew --dry-run --json
normalize stdout rename.out
cmp rename.out rename.json
snapshot $HOME rename-after.txt
cmp rename-after.txt rename-before.txt

exec aigw account edit team --anthropic-url $UPSTREAM --json
normalize stdout edit.out
cmp edit.out edit.json
exitcode 1 aigw account edit missing --label 'Missing' --json
cmp stdout edit-refusal.json

# Previews of an edit write nothing below the private home.
snapshot $HOME before.txt
exec aigw account edit team --label 'Preview Gateway' --dry-run
cmp stdout edit-preview.txt
exec aigw account edit team --anthropic-url $UPSTREAM/v2 --dry-run --json
normalize stdout edit-preview.out
[!windows] cmp edit-preview.out edit-preview.json
[windows] cmp edit-preview.out edit-preview-windows.json
snapshot $HOME after.txt
cmp after.txt before.txt

envsubst probe.in probe.toml
exec aigw config import probe.toml
stdin system.txt
exec aigw account diagnostics enable probed --user-id 42 --system-token-stdin --json
cmp stdout enabled.json
exitcode 1 aigw account diagnostics enable probed --json
cmp stdout enable-refusal.json
exec aigw account diagnostics disable probed --json
cmp stdout disabled.json
exitcode 1 aigw account diagnostics disable missing --json
cmp stdout disable-refusal.json

-- edit-preview.txt --
AIGW  Account edit preview
────────────────────────────────────────
  Account              team

Projection targets
  ✓ Projection         No client configuration needs changing
  ✓ Preview did not write configuration, credentials or client files

Next
  Run the same command without --dry-run to apply this plan
-- edit-preview.json --
{
  "schema_version": 1,
  "ok": true,
  "dry_run": true,
  "account": "team",
  "label": "Renamed Gateway",
  "endpoints": {
    "anthropic": "$UPSTREAM/v2"
  },
  "projections": [
    {
      "client": "claude",
      "surface": "claude-settings",
      "target": "~/.claude/settings.json",
      "action": "project"
    }
  ],
  "next_action": "aigw account edit team --anthropic-url $UPSTREAM/v2"
}
-- edit-preview-windows.json --
{
  "schema_version": 1,
  "ok": true,
  "dry_run": true,
  "account": "team",
  "label": "Renamed Gateway",
  "endpoints": {
    "anthropic": "$UPSTREAM/v2"
  },
  "projections": [
    {
      "client": "claude",
      "surface": "claude-settings",
      "target": "~/.claude/settings.json",
      "action": "project"
    }
  ],
  "next_action": "aigw account edit team --anthropic-url $UPSTREAM/v2"
}
-- token.txt --
sk-team-token-0001
-- help.txt --
AIGW  aigw account
────────────────────────────────────────
  Manage account endpoints and optional precise diagnostics

Usage
  aigw account [command]

Commands
  diagnostics          Manage optional precise provider diagnostics
  edit                 Update account metadata and protocol endpoints
  list                 List account endpoints without credential values
  rename               Rename an account and update its route references

Options
  -h, --help   help for account
-- accounts.json --
{
  "schema_version": 1,
  "ok": true,
  "accounts": [
    {
      "id": "team",
      "label": "Team Gateway",
      "endpoints": {
        "anthropic": "$UPSTREAM"
      }
    }
  ]
}
