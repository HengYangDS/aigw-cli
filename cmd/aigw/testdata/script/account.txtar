-- system.txt --
dmx-system-token
-- probe.in --
version = 7
[accounts.probed]
label = "Probed Gateway"
[accounts.probed.endpoints]
anthropic = "$UPSTREAM"
[accounts.probed.account_probe]
kind = "dmxapi"
base_url = "$UPSTREAM"
[models.probe-model]
label = "Probe Model"
[routes.probe-route]
label = "Probe Route"
account = "probed"
model = "probe-model"
upstream_model = "probe-model"
interfaces = { anthropic = ["text"] }
