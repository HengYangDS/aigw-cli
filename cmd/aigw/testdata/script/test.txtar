# test refuses an empty home, observes the connected client's endpoint,
# and refuses a client without a selected Route. Without --for it probes
# only the enabled clients; --for still names a disabled client's Route.
exec aigw test --help
cmp stdout help.txt

exitcode 1 aigw test
cmp stdout empty.txt

stdin token.txt
exec aigw add team --label 'Team Gateway' --anthropic-url $UPSTREAM --upstream-model team-model --for claude --token-stdin
exec aigw test --for claude
cmp stdout tested.txt
exitcode 1 aigw test --for codex
cmp stdout codex.txt

exec aigw test --json
normalize stdout tested.out
cmp tested.out tested.json
exitcode 1 aigw test --for unknown --json
cmp stdout json-refusal.json

exec aigw client disable claude
exitcode 1 aigw test
cmp stdout disabled.txt
exec aigw test --for claude
cmp stdout tested.txt

-- token.txt --
sk-team-token-0001
-- help.txt --
AIGW  aigw test
────────────────────────────────────────
  Send a model-free HTTP request to the enabled clients' selected
  endpoints without changing client bindings. --for and --route can target
  one Route, also a disabled client's; --token-stdin uses a one-time Token
  without storing it. An endpoint response does not prove model inference
  or real-client behavior.

Usage
  aigw test [flags]

Options
      --config string         Read an absolute configuration file for a one-time stdin Token test
      --for string            Client whose selected Route to test: claude, claude-desktop, codex, or hermes
  -h, --help                  help for test
      --json                  Write the endpoint observations as JSON
      --route string          Test this Route for the explicit client without changing its binding
      --token-format string   Explicit stdin encoding: raw or go-keyring-base64 (default "raw")
      --token-stdin           Read one bounded Token through EOF for this request only; never store it
-- empty.txt --
AIGW  Action required
────────────────────────────────────────

Problem
  Not configured

Evidence
  No Routes have been created.

Impact
  No client endpoint is available to test.

Recommended action
  aigw setup
-- disabled.txt --
AIGW  Action required
────────────────────────────────────────

Problem
  No enabled client has a selected Route

Evidence
  Only disabled clients have a selected Route.

Impact
  Without --for, test probes only the enabled clients.

Recommended action
  aigw test --for <client>
-- tested.txt --
AIGW  Connectivity test
────────────────────────────────────────
  Endpoint HTTP observation, not model inference or native-client verification.

Endpoints
  ✓ Claude             team · HTTP 200

Next
  aigw check
-- codex.txt --
AIGW  Action required
────────────────────────────────────────

Problem
  no Route selected for client "codex"

Impact
  The command could not finish; inspect current state before retrying.

Recommended action
  aigw check
-- tested.json --
{
  "schema_version": 1,
  "ok": true,
  "endpoints": [
    {
      "client": "claude",
      "route": "team",
      "http_status": 200
    }
  ],
  "next_action": "aigw check"
}
-- json-refusal.json --
{
  "schema_version": 2,
  "ok": false,
  "error": "--for must be claude, claude-desktop, codex, or hermes; run `aigw test --help`",
  "impact": "The command could not finish; inspect current state before retrying.",
  "next_action": "aigw test --help"
}
