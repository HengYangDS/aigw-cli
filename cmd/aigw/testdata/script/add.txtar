# add refuses an Account without a model, connects an Account with its first
# Route, and refuses to replace an existing Account. With --json it reads the
# Token only from standard input.
exec aigw add --help
cmp stdout help.txt

stdin token.txt
exitcode 1 aigw add team --label 'Team Gateway' --anthropic-url $UPSTREAM --for claude --token-stdin
cmp stdout model.txt

# Previews read no Token and write nothing below the private home.
snapshot $HOME before.txt
# A preview's client file and credential reader paths differ by platform.
exec aigw add team --label 'Team Gateway' --anthropic-url $UPSTREAM --model team-model --for claude --dry-run
stdout 'Account connection preview'
stdout 'Token +Not read in a preview'
stdout 'Credential entrypoint'
stdout 'settings\.json +project'
stdout 'Run the same command without --dry-run to apply this plan'
exec aigw add team --anthropic-url $UPSTREAM --upstream-model team-model --for claude --dry-run --json
normalize stdout preview.out '[0-9a-f]{64}'
[darwin] cmp preview.out preview.json
[linux] cmp preview.out preview-linux.json
[windows] cmp preview.out preview-windows.json
snapshot $HOME after.txt
cmp after.txt before.txt
exitcode 1 aigw add team --anthropic-url $UPSTREAM --model team-model --upstream-model team-model --for claude
cmp stdout spellings.txt

stdin token.txt
exec aigw add team --label 'Team Gateway' --anthropic-url $UPSTREAM --model team-model --for claude --token-stdin
cmp stdout connected.txt
exec aigw account list --json
normalize stdout accounts.out
cmp accounts.out accounts.json

stdin token.txt
exitcode 1 aigw add team --label 'Team Gateway' --anthropic-url $UPSTREAM --model team-model --for claude --token-stdin
cmp stdout exists.txt

stdin token.txt
exec aigw add second --label 'Second Gateway' --anthropic-url $UPSTREAM --model second-model --for claude --token-stdin --json
cmp stdout second.json
exitcode 1 aigw add third --anthropic-url $UPSTREAM --model third-model --for claude --json
cmp stdout json-refusal.json

-- preview.json --
{
  "schema_version": 1,
  "ok": true,
  "dry_run": true,
  "account": "team",
  "route": "team",
  "client": "claude",
  "label": "team",
  "model": "team-model",
  "upstream_model": "team-model",
  "token_stored": false,
  "targets": [
    {
      "client": "claude",
      "target": "$HOME/.claude/settings.json",
      "action": "project"
    }
  ],
  "credential_entrypoint": {
    "path": "$HOME/Library/Application Support/aigw/credential/<varies>/aigw",
    "action": "install"
  },
  "next_action": "aigw add team --anthropic-url $UPSTREAM --for claude --upstream-model team-model"
}
