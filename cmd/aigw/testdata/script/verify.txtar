      "client": "claude",
      "route": "team",
      "state": "completed",
      "scope": "Native text response; tools and continuation are not probed"
    }
  ],
  "checkpoint_written": false,
  "next_action": "aigw doctor"
}
-- json-refusal.json --
{
  "schema_version": 2,
  "ok": false,
  "error": "choose a verification client with --for; run `aigw verify --help`",
  "impact": "The command could not finish; inspect current state before retrying.",
  "next_action": "aigw verify --help"
}
