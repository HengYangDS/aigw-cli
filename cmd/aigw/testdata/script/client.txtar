# client discovers the scripted Claude Code, disables and re-enables its
# projection, and refuses an unknown client, in text and as JSON.
exec aigw client --help
cmp stdout help.txt

stdin token.txt
exec aigw add team --label 'Team Gateway' --anthropic-url $UPSTREAM --model team-model --for claude --token-stdin
exec aigw client discover
stdout 'Claude +.*claude'
exec aigw client disable claude
cmp stdout disabled.txt
exec aigw client enable claude --executable $BIN/claude$exe
normalize stdout enabled.out
cmp enabled.out enabled.txt

exitcode 1 aigw client enable unknown
cmp stdout refusal.txt

exec aigw client disable claude --json
cmp stdout disabled.json
exec aigw client disable claude --json
cmp stdout already-disabled.json
exec aigw client enable claude --executable $BIN/claude$exe --json
cmp stdout enabled.json
exitcode 1 aigw client enable unknown --json
cmp stdout json-refusal.json
exitcode 1 aigw client disable unknown --json
cmp stdout disable-refusal.json
exitcode 1 aigw client discover extra --json
cmp stdout discover-refusal.json
# Claude Desktop's discovery also reads the host's applications, so the
# document is matched by its stable parts.
exec aigw client discover --json
stdout '"schema_version": 1'
stdout '"id": "claude",\n\s+"state": "found"'
stdout '"id": "codex",\n\s+"state": "not_found"'

-- token.txt --
sk-team-token-0001
-- help.txt --
AIGW  aigw client
────────────────────────────────────────
  Manage client projections

Usage
  aigw client [command]

Commands
  disable              Disable a client and remove AIGW-owned projections
  discover             Discover installed client executables
  enable               Enable a client projection

Options
  -h, --help   help for client
-- disabled.txt --
AIGW  Client disabled
────────────────────────────────────────
  Client               Claude
  ✓ All AIGW-owned projections were safely removed
-- enabled.txt --
AIGW  Client enabled
────────────────────────────────────────
  Client               Claude
  ✓ Projection         Configured

Next
  aigw check
-- refusal.txt --
AIGW  Action required
────────────────────────────────────────

Problem
  Client must be claude, claude-desktop, codex, or hermes; run `aigw client enable --help`: invalid argument "unknown" for "aigw client enable"

Impact
  The command could not finish; inspect current state before retrying.

Recommended action
  aigw client enable --help
-- disabled.json --
{
  "schema_version": 1,
  "ok": true,
  "client": "claude",
  "state": "disabled",
  "restart_required": false
}
-- already-disabled.json --
{
  "schema_version": 1,
  "ok": true,
  "client": "claude",
  "state": "already_disabled",
  "restart_required": false
}
-- enabled.json --
{
  "schema_version": 1,
  "ok": true,
  "client": "claude",
  "state": "enabled",
  "restart_required": false,
  "next_action": "aigw check"
}
