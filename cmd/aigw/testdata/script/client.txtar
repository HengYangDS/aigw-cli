# client lists every client with its model, whether it is enabled and where
# it is installed, discovers the scripted Claude Code, disables and re-enables
# its projection, edits a client's connection, and refuses an unknown client,
# in text and as JSON.
exec aigw client --help
cmp stdout help.txt

stdin token.txt
exec aigw provider add team --label 'Team Gateway' --endpoint anthropic=$UPSTREAM --token-stdin
exec aigw use claude team/team-model

# Claude Desktop's row depends on the host's applications, so it is matched
# by its stable part.
exec aigw client list
stdout 'Claude Desktop +No model selected · Disabled · '
normalize stdout list.out 'Claude Desktop .*'
[!windows] cmp list.out list.txt
[windows] cmp list.out list-windows.txt
exec aigw client list --json
stdout '"schema_version": 2'
stdout '"id": "claude",\n\s+"installed": true,\n\s+"executable": "[^"]+",\n\s+"enabled": true,\n\s+"model": "team/team-model"\n'
stdout '"id": "claude-desktop",\n\s+"installed": (?:false|true,\n\s+"executable": "[^"]+"),\n\s+"enabled": false\n'
stdout '"id": "codex",\n\s+"installed": false,\n\s+"enabled": false\n'
stdout '"id": "hermes",\n\s+"installed": false,\n\s+"enabled": false\n'
exitcode 1 aigw client list extra --json
cmp stdout list-refusal.json
fixloop -input stdout aigw client list extra --json

exec aigw client list
stdout 'Claude +.*claude'
exec aigw client disable claude
cmp stdout disabled.txt
exec aigw client enable claude --executable $BIN/claude$exe
normalize stdout enabled.out
cmp enabled.out enabled.txt

exitcode 1 aigw client enable unknown
cmp stdout refusal.txt

exec aigw client disable claude --json
cmp stdout disabled.json
exec aigw client disable claude --json
cmp stdout already-disabled.json
exec aigw client enable claude --executable $BIN/claude$exe --json
cmp stdout enabled.json
exitcode 1 aigw client enable unknown --json
cmp stdout json-refusal.json
fixloop -input stdout aigw client enable unknown --json
exitcode 1 aigw client disable unknown --json
cmp stdout disable-refusal.json
fixloop -input stdout aigw client disable unknown --json
# Claude Code reads no configuration file that a target could name.
exitcode 1 aigw client enable claude --executable $BIN/claude$exe --target settings.json --json
cmp stdout enable-target-refusal.json
fixloop -input stdout aigw client enable claude --executable $BIN/claude$exe --target settings.json --json

# Previews of disabling and enabling write nothing below the private home.
snapshot $HOME before.txt
exec aigw client disable claude --dry-run --json
normalize stdout disable-preview.out
[!windows] cmp disable-preview.out disable-preview.json
[windows] cmp disable-preview.out disable-preview-windows.json
snapshot $HOME after.txt
cmp after.txt before.txt
exec aigw client disable claude
snapshot $HOME disabled.txt
exec aigw client enable claude --executable $BIN/claude$exe --dry-run
normalize stdout enable-preview.out
[!windows] cmp enable-preview.out enable-preview.txt
[windows] cmp enable-preview.out enable-preview-windows.txt
snapshot $HOME still-disabled.txt
cmp still-disabled.txt disabled.txt

# client edit owns a client's connection: its executable, its configuration
# files, forwarding and retry budgets. Codex selects team's model on a new
# Responses endpoint; it is not installed, so its edits change the
# configuration alone until its configuration file is named.
exec aigw provider edit team --endpoint responses=$UPSTREAM/v1
exec aigw model edit team/team-model --protocol anthropic --protocol responses
exec aigw use codex team/team-model

# Previews write nothing below the private home.
snapshot $HOME edit-before.txt
exec aigw client edit codex --via http://127.0.0.1:8792/v1 --dry-run --json
cmp stdout edit-via-preview.json
exec aigw client edit codex --request-retries 0 --stream-retries 2 --dry-run
cmp stdout edit-retries-preview.txt
exec aigw client edit codex --target $HOME/.codex/config.toml --executable $WORK/codex --dry-run --json
stdout '"dry_run": true'
stdout '"file": "~/.codex/config.toml",\n\s+"action": "initial_project"'
snapshot $HOME edit-after.txt
cmp edit-after.txt edit-before.txt

# Forwarding and the budgets that an edit names change; the other budget,
# the provider, the model and the Token stay. AIGW writes no Codex file
# while Codex is not installed, so each edit names the step that writes
# them.
exec aigw client edit codex --request-retries 4
cmp stdout edit-deferred.txt
exec aigw client edit codex --via http://127.0.0.1:8792/v1 --request-retries 0 --stream-retries 2 --json
cmp stdout edit-forwarded.json
exec aigw client edit codex --direct --dry-run
cmp stdout edit-direct-preview.txt
exec aigw client edit codex --direct --stream-retries 3 --json
cmp stdout edit-direct.json
exec aigw client edit codex --direct --json
cmp stdout edit-unchanged.json
# An edit that changes nothing says so and names no next step.
exec aigw client edit codex --direct
cmp stdout edit-unchanged.txt
exec aigw client edit codex --native-retries --dry-run
cmp stdout edit-native-preview.txt
exec aigw client edit codex --native-retries --json
cmp stdout edit-native.json

# Naming Codex's configuration file writes AIGW's settings there.
exec aigw client edit codex --target $HOME/.codex/config.toml --executable $WORK/codex --json
stdout '"changed": true'
stdout '"targets": \[\n\s+"[^"]+config\.toml"\n\s+\]'
stdout '"file": "~/.codex/config.toml",\n\s+"action": "initial_project"'
grep 'AIGW managed provider' $HOME/.codex/config.toml
exec aigw client list
stdout 'Codex +team/team-model · Enabled · Not installed'

# Codex moves to a configuration file in its own folder, which is then
# deleted, file and record together, leaving nothing to withdraw. AIGW does
# not create a Codex home outside the default one, so status, check and sync
# all name the file and the folder to create, since the folder alone
# leaves the same command refused; none names sync alone, which would refuse.
# A check completes the repair with the sync that projects into the new file
# and names no file outside the home directory, which the test's $WORK is,
# while sync, a command, names the file as the operator gave it and runs
# again. The move succeeds and reports the deleted file as absent, and
# disabling Codex then withdraws only the new file.
mkdir $WORK/a $WORK/b
cp $WORK/codex-config.toml $WORK/a/config.toml
cp $WORK/codex-config.toml $WORK/b/config.toml
exec aigw client edit codex --target $WORK/a/config.toml
exec aigw sync
rm $WORK/a
exec aigw status --json
stdout '"next_detail": "Create the file outside the home directory and the folder that holds it, then run `aigw sync`."'
! stdout '"next_action": "aigw sync"'
exitcode 1 aigw check codex --json
stdout '"next_detail": "Create the file outside the home directory and the folder that holds it, then run `aigw sync`."'
! stdout '"next_action"'
cp stdout check-deleted.json
exitcode 1 aigw sync --json
stdout '"error": ".*Codex config does not exist, and AIGW does not create a Codex home"'
stdout '"next_detail": "Create .*config\.toml and the folder that holds it, then run the same command again\."'
cp stdout sync-deleted.json
# Followed, each fix lets its command run: the script creates the file and
# its folder again, and sync then projects into the file. The file then goes
# again for the move below.
mkdir $WORK/a
cp $WORK/codex-config.toml $WORK/a/config.toml
fixloop -did 'created the file and its folder' sync-deleted.json aigw sync --json
fixloop -did 'created the file and its folder, and ran aigw sync' check-deleted.json aigw check codex --json
rm $WORK/a
exec aigw client edit codex --target $WORK/b/config.toml --json
stdout '"changed": true'
stdout '"action": "absent"'
stdout '"action": "initial_project"'
grep 'AIGW managed provider' $WORK/b/config.toml
exec aigw client disable codex
cmp $WORK/b/config.toml $WORK/codex-config.toml

# Refusals name what is wrong before anything is read or written.
exitcode 1 aigw client edit codex --json
cmp stdout edit-nothing.json
fixloop -input stdout aigw client edit codex --json
exitcode 1 aigw client edit claude --request-retries 1
cmp stdout edit-no-budgets.txt
exitcode 1 aigw client edit claude --json --request-retries 1
fixloop -input stdout aigw client edit claude --json --request-retries 1
exitcode 1 aigw client edit codx --direct --json
cmp stdout edit-unknown.json
fixloop -input stdout aigw client edit codx --direct --json
exitcode 1 aigw client edit hermes --via http://127.0.0.1:8792/v1 --json
cmp stdout edit-no-model.json
exitcode 1 aigw client edit codex --via http://proxy.test/v1 --json
cmp stdout edit-plain-http.json
fixloop -input stdout aigw client edit codex --via http://proxy.test/v1 --json
exitcode 1 aigw client edit codex --via http://127.0.0.1:8792/v1 --direct --json
cmp stdout edit-both.json
fixloop -input stdout aigw client edit codex --via http://127.0.0.1:8792/v1 --direct --json

# Hermes forwards once it selects a model, as its refusal names.
exec aigw use hermes team/team-model --protocol responses
fixloop -did 'selected team/team-model for Hermes' edit-no-model.json aigw client edit hermes --via http://127.0.0.1:8792/v1 --json
-- disable-preview.json --
{
  "schema_version": 2,
  "ok": true,
  "dry_run": true,
  "client": "claude",
  "state": "disabled",
  "restart_required": false,
  "client_files": [
    {
      "client": "claude",
      "file": "~/.claude/settings.json",
      "action": "restore"
    }
  ],
  "next_action": "aigw client disable claude"
}
-- disable-preview-windows.json --
