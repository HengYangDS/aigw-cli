{
  "schema_version": 1,
  "ok": false,
  "error": "Client must be claude, claude-desktop, codex, or hermes; run `aigw client enable --help`: invalid argument \"unknown\" for \"aigw client enable\"",
  "impact": "The command could not finish; inspect current state before retrying.",
  "next_action": "aigw client enable --help"
}
-- disable-refusal.json --
{
  "schema_version": 1,
  "ok": false,
  "error": "Client must be claude, claude-desktop, codex, or hermes; run `aigw client disable --help`: invalid argument \"unknown\" for \"aigw client disable\"",
  "impact": "The command could not finish; inspect current state before retrying.",
  "next_action": "aigw client disable --help"
}
-- discover-refusal.json --
{
  "schema_version": 1,
  "ok": false,
  "error": "unknown command \"extra\"",
  "impact": "The command could not finish; inspect current state before retrying.",
  "next_action": "aigw --help"
}
