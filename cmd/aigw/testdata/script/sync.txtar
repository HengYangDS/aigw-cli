# sync refuses an empty home, then previews and applies the synchronization
# of the connected client's projection.
exec aigw sync --help
cmp stdout help.txt

exitcode 1 aigw sync
cmp stdout empty.txt
exitcode 1 aigw sync --json
cmp stdout empty.json
exitcode 1 aigw sync --dry-run --json
cp stdout empty-preview.json

stdin token.txt
exec aigw provider add team --label 'Team Gateway' --endpoint anthropic=$UPSTREAM --token-stdin
exec aigw use claude team/team-model
# Its fix, run as setup does, lets the same preview run.
fixloop -did 'added team with a model for Claude, as aigw setup does' empty-preview.json aigw sync --dry-run --json
snapshot $HOME before.txt
exec aigw sync --dry-run --json
normalize stdout preview.out
[!windows] cmp preview.out preview.json
[windows] cmp preview.out preview-windows.json
snapshot $HOME after.txt
cmp after.txt before.txt
exec aigw sync
normalize stdout synced.out
cmp synced.out synced.txt

-- token.txt --
sk-team-token-0001
-- help.txt --
AIGW  aigw sync
────────────────────────────────────────
  Make client files match the configuration

Usage
  aigw sync [flags]

Examples
  aigw sync
  aigw sync --dry-run
  aigw sync --json

Options
      --dry-run   Show the synchronization plan without writing configuration
  -h, --help      help for sync
      --json      Write the synchronization preview or result as JSON
-- empty.txt --
AIGW  Action required
────────────────────────────────────────

Problem
  Not configured

Evidence
  No provider has been added.

Fix
  aigw setup
-- preview.json --
{
  "schema_version": 3,
  "ok": true,
  "dry_run": true,
  "selections": {
    "claude": "team/team-model"
  },
  "client_files": [
    {
      "client": "claude",
      "file": "~/.claude/settings.json",
      "action": "already_converged"
    }
  ],
  "enabled_clients": 1,
  "next_action": "aigw check"
}
-- synced.txt --
AIGW  Synchronization completed
────────────────────────────────────────
  ✓ Client configuration is aligned; authentication was unchanged

Next
  aigw check
-- empty.json --
{
  "schema_version": 3,
  "ok": false,
  "error": "Not configured",
  "evidence": "No provider has been added.",
  "next_detail": "aigw setup"
}
-- preview-windows.json --
{
  "schema_version": 3,
  "ok": true,
  "dry_run": true,
  "selections": {
    "claude": "team/team-model"
  },
  "client_files": [
    {
      "client": "claude",
      "file": "~/.claude/settings.json",
      "action": "already_converged"
    }
  ],
  "enabled_clients": 1,
  "next_action": "aigw check"
}
