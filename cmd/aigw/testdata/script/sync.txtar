# sync refuses an empty home, then previews and applies the synchronization
# of the connected client's projection.
exec aigw sync --help
cmp stdout help.txt

exitcode 1 aigw sync
cmp stdout empty.txt
exitcode 1 aigw sync --json
cmp stdout empty.json

stdin token.txt
exec aigw add team --label 'Team Gateway' --anthropic-url $UPSTREAM --upstream-model team-model --for claude --token-stdin
snapshot $HOME before.txt
exec aigw sync --dry-run --json
normalize stdout preview.out
[!windows] cmp preview.out preview.json
[windows] cmp preview.out preview-windows.json
snapshot $HOME after.txt
cmp after.txt before.txt
exec aigw sync
normalize stdout synced.out
cmp synced.out synced.txt

-- token.txt --
sk-team-token-0001
-- help.txt --
AIGW  aigw sync
────────────────────────────────────────
  Resynchronize client configuration

Usage
  aigw sync [flags]

Options
      --dry-run   Show the synchronization plan without writing configuration
  -h, --help      help for sync
      --json      Write the synchronization preview or result as JSON
-- empty.txt --
AIGW  Action required
────────────────────────────────────────

Problem
  Not configured

Evidence
  No Routes have been created.

Impact
  Cannot check, synchronize, or repair configuration that does not exist.

Fix
  aigw setup
-- preview.json --
{
  "schema_version": 2,
  "ok": true,
  "dry_run": true,
  "selections": {
    "claude": "team"
  },
  "projections": [
    {
      "client": "claude",
      "surface": "claude-settings",
      "target": "~/.claude/settings.json",
      "action": "already_converged"
    }
  ],
  "enabled_clients": 1,
  "next_action": "aigw check"
}
-- synced.txt --
AIGW  Synchronization completed
────────────────────────────────────────
  ✓ Client configuration is aligned; authentication was unchanged

Next
  aigw check
-- empty.json --
{
  "schema_version": 3,
  "ok": false,
  "error": "Not configured",
  "evidence": "No Routes have been created.",
  "impact": "Cannot check, synchronize, or repair configuration that does not exist.",
  "next_detail": "aigw setup"
}
-- preview-windows.json --
{
  "schema_version": 2,
  "ok": true,
  "dry_run": true,
  "selections": {
    "claude": "team"
  },
  "projections": [
    {
      "client": "claude",
      "surface": "claude-settings",
      "target": "~/.claude/settings.json",
      "action": "already_converged"
    }
  ],
  "enabled_clients": 1,
  "next_action": "aigw check"
}
