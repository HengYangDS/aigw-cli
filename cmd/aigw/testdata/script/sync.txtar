# sync refuses an empty home, then previews and applies the synchronization
# of the connected client's projection.
exec aigw sync --help
cmp stdout help.txt

exitcode 1 aigw sync
cmp stdout empty.txt
exitcode 1 aigw sync --json
cmp stdout empty.json

stdin token.txt
exec aigw add team --label 'Team Gateway' --anthropic-url $UPSTREAM --model team-model --for claude --token-stdin
exec aigw sync --dry-run --json
normalize stdout preview.out
[!windows] cmp preview.out preview.json
[windows] cmp preview.out preview-windows.json
exec aigw sync
normalize stdout synced.out
cmp synced.out synced.txt

-- token.txt --
sk-team-token-0001
-- help.txt --
AIGW  aigw sync
────────────────────────────────────────
  Resynchronize client configuration

Usage
  aigw sync [flags]

Options
      --dry-run   Show the synchronization plan without writing configuration
  -h, --help      help for sync
      --json      Write the synchronization preview or result as JSON
-- empty.txt --
AIGW  Action required
────────────────────────────────────────

Problem
  refuse invalid config: at least one route is required

Impact
  The command could not finish; inspect current state before retrying.

Recommended action
  aigw check
-- preview.json --
{
  "schema_version": 1,
  "ok": true,
  "dry_run": true,
  "selections": {
    "claude": "team"
  },
  "targets": [
    {
      "client": "claude",
      "target": "$HOME/.claude/settings.json",
      "action": "already-converged"
    }
  ],
  "enabled_clients": 1,
  "next_action": "aigw check"
}
-- synced.txt --
AIGW  Synchronization completed
────────────────────────────────────────
  ✓ Client configuration is aligned; authentication was unchanged

Next
  aigw check
-- empty.json --
{
  "schema_version": 1,
  "ok": false,
  "error": "refuse invalid config: at least one route is required",
  "impact": "The command could not finish; inspect current state before retrying.",
  "next_action": "aigw check"
}
-- preview-windows.json --
{
  "schema_version": 1,
  "ok": true,
  "dry_run": true,
  "selections": {
    "claude": "team"
  },
  "targets": [
    {
      "client": "claude",
      "target": "$HOME\\.claude\\settings.json",
      "action": "already-converged"
    }
  ],
  "enabled_clients": 1,
  "next_action": "aigw check"
}
