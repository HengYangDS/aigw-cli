# sync refuses an empty home, then previews and applies the synchronization
# of the connected client's projection.
exec aigw sync --help
cmp stdout help.txt

exitcode 1 aigw sync
cmp stdout empty.txt
exitcode 1 aigw sync --json
cmp stdout empty.json
exitcode 1 aigw sync --dry-run --json
cp stdout empty-preview.json

stdin token.txt
exec aigw provider add team --label 'Team Gateway' --endpoint anthropic=$UPSTREAM --token-stdin
exec aigw use claude team/team-model
# Its fix, run as setup does, lets the same preview run.
fixloop -did 'added team with a model for Claude, as aigw setup does' empty-preview.json aigw sync --dry-run --json
snapshot $HOME before.txt
exec aigw sync --dry-run --json
normalize stdout preview.out
cmp preview.out preview.json
snapshot $HOME after.txt
cmp after.txt before.txt
exec aigw sync
normalize stdout synced.out
cmp synced.out synced.txt

# Codex's declared program goes after a sync wrote its file. Sync keeps the
# program, synchronizes Claude Code, leaves Codex's file and AIGW's record as
# they were and fails with the fix that declares another program, as its
# preview and a check do; a sync is no fix. A --program that is not a file
# that can run is refused before anything changes.
exec aigw provider edit team --endpoint responses=$UPSTREAM/v1
exec aigw model edit team/team-model --protocol anthropic --protocol responses
exec aigw use codex team/team-model
mkdir $WORK/codex
cp codex-config.toml $WORK/codex/config.toml
exitcode 1 aigw client edit codex --target $WORK/codex/config.toml --program $WORK/gone/codex
stdout 'is not a file that can run'
cmp $WORK/codex/config.toml codex-config.toml
mkdir $WORK/gone
cp codex-program $WORK/gone/codex
chmod 0755 $WORK/gone/codex
exec aigw client edit codex --target $WORK/codex/config.toml --program $WORK/gone/codex
grep 'AIGW managed provider' $WORK/codex/config.toml
cp $WORK/codex/config.toml synced.toml
cp $WORK/codex/config.toml.aigw-state.json synced-record.json
rm $WORK/gone
exitcode 1 aigw sync --json
stdout '"ok": false'
stdout '"enabled_clients": 2'
stdout '"problem": "Codex program is missing",\n\s+"files": "left as they were",\n\s+"next_detail": "aigw client edit codex --program \\u003cpath\\u003e or --extensions \\u003cdir\\u003e"'
exitcode 1 aigw sync
stdout 'Codex program is missing'
exitcode 1 aigw sync --dry-run --json
stdout '"stopped_clients": \[\n\s+\{\n\s+"client": "codex",\n\s+"problem": "Codex program is missing",\n\s+"files": "left as they are",\n\s+"next_detail": "aigw client edit codex --program \\u003cpath\\u003e or --extensions \\u003cdir\\u003e"'
stdout '"client": "claude"'
exitcode 1 aigw check codex --depth local --json
stdout '"next_detail": "aigw client edit codex --program \\u003cpath\\u003e or --extensions \\u003cdir\\u003e"'
cmp $WORK/codex/config.toml synced.toml
cmp $WORK/codex/config.toml.aigw-state.json synced-record.json

# In a new home, a selection made while Claude Code is not on the PATH
# enables it without a program. A sync then adopts the program that it finds
# on the PATH and says so, as its preview does without saving it, and saves
# it once: a second sync adopts nothing and leaves aigw.toml byte for byte as
# it was.
mkdir $WORK/fresh
env HOME=$WORK/fresh
env XDG_CONFIG_HOME=$WORK/fresh
env XDG_DATA_HOME=$WORK/fresh
env PATH=$WORK/fresh
stdin token.txt
exec $BIN/aigw$exe provider add team --label 'Team Gateway' --endpoint anthropic=$UPSTREAM --token-stdin
exec $BIN/aigw$exe use claude team/team-model
! stdout 'Adopted program'
! exists $WORK/fresh/.claude/settings.json
env PATH=$BIN
exec aigw sync --dry-run
stdout 'Adopted program\n  A run would save .+, where AIGW found Claude Code, as its program in aigw\.toml\.'
[darwin] ! grep '^program = ' $WORK/fresh/Library/Application' 'Support/aigw/aigw.toml
[!darwin] ! grep '^program = ' $WORK/fresh/aigw/aigw.toml
exec aigw sync
stdout 'Adopted program\n  AIGW found Claude Code at .+ and saved it as its program in aigw\.toml\.'
exists $WORK/fresh/.claude/settings.json
[darwin] cp $WORK/fresh/Library/Application' 'Support/aigw/aigw.toml adopted.toml
[!darwin] cp $WORK/fresh/aigw/aigw.toml adopted.toml
grep '^program = ' adopted.toml
exec aigw sync --json
! stdout 'adopted_programs'
[darwin] cmp $WORK/fresh/Library/Application' 'Support/aigw/aigw.toml adopted.toml
[!darwin] cmp $WORK/fresh/aigw/aigw.toml adopted.toml

# A client that declares an extensions directory uses the program of the
# newest installed version of its extension, which aigw.toml never names.
mkdir $WORK/extensions/anthropic.claude-code-2.0.9/resources/native-binary
mkdir $WORK/extensions/anthropic.claude-code-2.1.0/resources/native-binary
cp $BIN/claude$exe $WORK/extensions/anthropic.claude-code-2.1.0/resources/native-binary/claude
chmod 0755 $WORK/extensions/anthropic.claude-code-2.1.0/resources/native-binary/claude
exec aigw client edit claude --extensions $WORK/extensions --json
stdout '"extensions": "[^"]+extensions"'
! stdout '"program"'
exec aigw sync
exec aigw client list --json
stdout '"program": "[^"]+anthropic\.claude-code-2\.1\.0[^"]+claude",\n\s+"extensions": "[^"]+extensions"'
[darwin] ! grep '^program = ' $WORK/fresh/Library/Application' 'Support/aigw/aigw.toml
[!darwin] ! grep '^program = ' $WORK/fresh/aigw/aigw.toml

-- codex-program --
#!/bin/sh
exit 1
-- codex-config.toml --
model_provider = "native"
-- token.txt --
sk-team-token-0001
-- help.txt --
AIGW  aigw sync
────────────────────────────────────────
  Make client files match the configuration

Usage
  aigw sync [flags]

Examples
  aigw sync
  aigw sync --dry-run
  aigw sync --json

Options
      --dry-run[=true|false]   Show the synchronization plan without writing configuration
  -h, --help[=true|false]      help for sync
      --json[=true|false]      Write the synchronization preview or result as JSON
-- empty.txt --
AIGW  Action required
────────────────────────────────────────

Problem
  Not configured

Evidence
  No provider has been added.

Fix
  aigw setup
-- preview.json --
{
  "schema_version": 4,
  "ok": true,
  "dry_run": true,
  "selections": {
    "claude": "team/team-model"
  },
  "client_files": [
    {
      "client": "claude",
      "file": "~/.claude/settings.json",
      "action": "already_converged"
    }
  ],
  "enabled_clients": 1,
  "next_action": "aigw check"
}
-- synced.txt --
AIGW  Synchronization completed
────────────────────────────────────────
  ✓ Client configuration is aligned; authentication was unchanged

Next
  aigw check
-- empty.json --
{
  "schema_version": 3,
  "ok": false,
  "error": "Not configured",
  "evidence": "No provider has been added.",
  "next_detail": "aigw setup"
}
