# status reports each client's readiness before and after an Account
# connects, in text and as JSON, and refuses an unreadable configuration.
exec aigw status --help
cmp stdout help.txt

exec aigw status --json
cmp stdout empty.json

stdin token.txt
exec aigw add team --label 'Team Gateway' --anthropic-url $UPSTREAM --model team-model --for claude --token-stdin
exec aigw status --json
cmp stdout connected.json
exec aigw status
cmp stdout connected.txt

[darwin] cp broken.toml $HOME/Library/Application' 'Support/aigw/config.toml
[!darwin] cp broken.toml $HOME/aigw/config.toml
! exec aigw status
cmp stdout refusal.txt
! exec aigw status --json
cmp stdout refusal.json

-- token.txt --
sk-team-token-0001
-- broken.toml --
version = 7
[accounts.team
-- help.txt --
AIGW  aigw status
────────────────────────────────────────
  Show each client's selected route and local readiness

Usage
  aigw status [flags]

Options
  -h, --help   help for status
      --json   Write machine-readable JSON
