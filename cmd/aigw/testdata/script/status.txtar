# status reports each client's model, named provider/model, and its local
# readiness, in text and as JSON: none in an empty home, then a configured
# client, a deferred one and clients that select no model. It refuses an
# unreadable configuration.
exec aigw status --help
cmp stdout help.txt

exec aigw status --json
cmp stdout empty.json
exec aigw status
cmp stdout empty.txt

# Claude Code is configured. Codex selects the same model on team's new
# Responses endpoint, but it is not installed, so its files wait. Claude
# Desktop and Hermes select no model.
stdin token.txt
exec aigw add team --label 'Team Gateway' --anthropic-url $UPSTREAM --upstream-model team-model --for claude --token-stdin
exec aigw provider edit team --endpoint responses=$UPSTREAM/v1
exec aigw model edit team/team-model --protocol anthropic --protocol responses
exec aigw use codex team/team-model
exec aigw status --json
cmp stdout connected.json
exec aigw status
cmp stdout connected.txt

# A disabled client keeps its selection but names no step of its own, so the
# status names the step that the enabled client needs, also after a sync,
# which skips a disabled client.
exec aigw client disable codex
exec aigw status --json
cmp stdout disabled.json
exec aigw sync
exec aigw status
cmp stdout disabled.txt

[darwin] cp $HOME/Library/Application' 'Support/aigw/config.toml good.toml
[!darwin] cp $HOME/aigw/config.toml good.toml
[darwin] cp broken.toml $HOME/Library/Application' 'Support/aigw/config.toml
[!darwin] cp broken.toml $HOME/aigw/config.toml
exitcode 1 aigw status
cmp stdout refusal.txt
exitcode 1 aigw status --json
cmp stdout refusal.json
[darwin] cp good.toml $HOME/Library/Application' 'Support/aigw/config.toml
[!darwin] cp good.toml $HOME/aigw/config.toml
fixloop -did 'restored the configuration file from a copy' refusal.json aigw status --json

# Claude Code installed after its model was selected: without claude on the
# search path, add selects the model and writes no Claude Code file, and
# status says that Claude Code is not installed. With claude on the search
# path, status names aigw sync, which writes its files.
env HOME=$WORK/later USERPROFILE=$WORK/later XDG_CONFIG_HOME=$WORK/later XDG_DATA_HOME=$WORK/later APPDATA=$WORK/later LOCALAPPDATA=$WORK/later
env PATH=$WORK/nothing
stdin token.txt
exec $BIN/aigw add team --label 'Team Gateway' --anthropic-url $UPSTREAM --upstream-model team-model --for claude --token-stdin
exec $BIN/aigw status
cmp stdout absent.txt
env PATH=$BIN
exec aigw status --json
cmp stdout installed.json
exec aigw status
cmp stdout installed.txt
exec aigw sync
exec aigw status
stdout 'Claude +team/team-model · Configured'

-- token.txt --
sk-team-token-0001
-- broken.toml --
version = 7
[accounts.team
