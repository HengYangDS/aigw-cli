# status reports each client's model, named provider/model, and its local
# readiness, in text and as JSON: none in an empty home, then a configured
# client, a deferred one and clients that select no model. It refuses an
# unreadable configuration.
exec aigw status --help
cmp stdout help.txt

exec aigw status --json
cmp stdout empty.json
exec aigw status
cmp stdout empty.txt

# Claude Code is configured. Codex selects the same model on team's new
# Responses endpoint, but it is not installed, so its files wait. Claude
# Desktop and Hermes select no model.
stdin token.txt
exec aigw add team --label 'Team Gateway' --anthropic-url $UPSTREAM --upstream-model team-model --for claude --token-stdin
exec aigw provider edit team --endpoint responses=$UPSTREAM/v1
exec aigw model edit team/team-model --protocol anthropic --protocol responses
exec aigw use --for codex team
exec aigw status --json
cmp stdout connected.json
exec aigw status
cmp stdout connected.txt

[darwin] cp broken.toml $HOME/Library/Application' 'Support/aigw/config.toml
[!darwin] cp broken.toml $HOME/aigw/config.toml
exitcode 1 aigw status
cmp stdout refusal.txt
exitcode 1 aigw status --json
cmp stdout refusal.json

-- token.txt --
sk-team-token-0001
-- broken.toml --
version = 7
[accounts.team
-- help.txt --
AIGW  aigw status
────────────────────────────────────────
  Show each client's model and local readiness

Usage
  aigw status [flags]

Options
  -h, --help   help for status
      --json   Write machine-readable JSON
-- empty.txt --
AIGW  Not configured
────────────────────────────────────────

Get started
  Run the guided setup once to add a provider, its Token and a first model.

Next
  aigw setup
