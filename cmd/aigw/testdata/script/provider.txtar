# provider lists, shows, adds, edits and removes providers, rotates their
# Tokens and reports their balances. Each subcommand writes JSON, each write
# previews without writing anything, add and rotate store only a Token that the
# provider accepts and never prompt without a terminal, an endpoint edit clears
# the capabilities qualified on the old endpoint, a failed balance probe hides
# no other provider, and a provider whose model a client uses is not removed.
exec aigw provider --help
cmp stdout help.txt
exec aigw provider add --help
cmp stdout add-help.txt

# team serves Anthropic Messages from the scripted upstream, which lists
# team-model and spare-model and answers the DMXAPI balance probe. mixed has an
# Anthropic and a Chat Completions endpoint, a balance probe and no Token, and
# Hermes's recommendation names its model.
envsubst manifest.in manifest.toml
exec aigw config import manifest.toml
stdin token.txt
exec aigw provider rotate team --token-stdin
cmp stdout rotated.txt

exec aigw provider list
cmp stdout list.txt
exec aigw provider list --json
normalize stdout list.out
cmp list.out list.json
exitcode 1 aigw provider list stray --json
cmp stdout list-refusal.json
exec aigw provider show team --json
normalize stdout show.out
cmp show.out show.json
exitcode 1 aigw provider show tem --json
cmp stdout show-unknown.json
exitcode 1 aigw provider show
cmp stdout show-missing.txt

# Previews read no Token, send no request and write nothing below the home.
snapshot $HOME before.txt
exec aigw provider add spare --endpoint responses=$UPSTREAM/spare/v1 --dry-run --json
normalize stdout add-preview.out
cmp add-preview.out add-preview.json
exec aigw provider edit team --endpoint anthropic=$UPSTREAM/v2 --dry-run
normalize stdout edit-preview.out
cmp edit-preview.out edit-preview.txt
exec aigw provider remove mixed --dry-run --json
cmp stdout remove-preview.json
snapshot $HOME after.txt
cmp after.txt before.txt

# Without a terminal, and with JSON, a Token comes only from --token-stdin.
exitcode 1 aigw provider add spare --endpoint responses=$UPSTREAM/spare/v1
normalize stdout add-no-terminal.out
cmp add-no-terminal.out add-no-terminal.txt
exitcode 1 aigw provider rotate team --json
cmp stdout rotate-no-terminal.json

# A Token that the provider rejects, or whose check cannot complete, is not
# stored, and the previous one stays.
stdin rejected.txt
exitcode 1 aigw provider add spare --endpoint responses=$UPSTREAM/spare/v1 --token-stdin --json
normalize stdout add-rejected.out
cmp add-rejected.out add-rejected.json
stdin spare-token.txt
exitcode 1 aigw provider add spare --endpoint responses=$UPSTREAM/unavailable/v1 --token-stdin
normalize stdout add-unavailable.out
cmp add-unavailable.out add-unavailable.txt
stdin spare-token.txt
exec aigw provider add spare --label Spare --endpoint responses=$UPSTREAM/spare/v1 --token-stdin --json
normalize stdout added.out
cmp added.out added.json
exitcode 1 aigw provider add spare --endpoint responses=$UPSTREAM/spare/v1 --token-stdin
cmp stdout add-exists.txt
stdin rejected.txt
exitcode 1 aigw provider rotate spare --token-stdin
cmp stdout rotate-rejected.txt
stdin spare-token.txt
exec aigw provider rotate spare --token-stdin --json
cmp stdout rotated.json

# Replacing team's Anthropic endpoint clears the tool search that was
# qualified on the old one.
exec aigw provider edit team --endpoint anthropic=$UPSTREAM/v2 --json
normalize stdout edited.out
cmp edited.out edited.json
exitcode 1 aigw provider edit team --json
cmp stdout edit-nothing.json
exitcode 1 aigw provider edit team --balance-token-stdin
cmp stdout edit-pair.txt
exitcode 1 aigw provider edit spare --balance-token-stdin --balance-user-id 42
cmp stdout edit-no-probe.txt
stdin system.txt
exec aigw provider edit team --balance-token-stdin --balance-user-id 42
normalize stdout edit-balance.out
cmp edit-balance.out edit-balance.txt

# A provider without a probe does not fail, and mixed's probe, which has no
# balance credentials, hides no other provider.
exec aigw provider balance team spare
cmp stdout balance.txt
exec aigw provider balance spare --json
cmp stdout balance-spare.json
exitcode 1 aigw provider balance --json
cmp stdout balance.json
exitcode 1 aigw provider balance tem --json
cmp stdout balance-unknown.json

# A model that a client selects keeps its provider, even in a preview, and an
# unused provider goes with its models and drops Hermes's recommendation.
exec aigw use --for claude team-route
exitcode 1 aigw provider remove team --json
cmp stdout remove-selected.json
exitcode 1 aigw provider remove team --dry-run --json
cmp stdout remove-blocked.json
exec aigw provider remove mixed --json
cmp stdout removed.json
exec aigw provider list
cmp stdout list-after.txt
exec aigw provider edit team --no-balance-token --json
normalize stdout unbalanced.out
cmp unbalanced.out unbalanced.json

# The read-only environment backend keeps its variables, which the removal
# names.
env AIGW_SECRET_BACKEND=env
env AIGW_TOKEN_SPARE=sk-spare-token-0001
exec aigw provider remove spare
cmp stdout removed-environment.txt

-- token.txt --
sk-team-token-0001
-- spare-token.txt --
sk-spare-token-0001
-- rejected.txt --
sk-rejected-token
-- system.txt --
dmx-system-token
-- manifest.in --
version = 7
[recommendations.hermes.primary]
route = "mixed-chat"
protocol = "openai_chat_completions"
[accounts.team]
label = "Team Gateway"
[accounts.team.endpoints]
anthropic = "$UPSTREAM"
[accounts.team.account_probe]
kind = "dmxapi"
base_url = "$UPSTREAM"
[accounts.mixed]
label = "Mixed"
[accounts.mixed.endpoints]
anthropic = "$UPSTREAM/mixed"
openai_chat_completions = "$UPSTREAM/mixed/v1"
[accounts.mixed.account_probe]
kind = "dmxapi"
base_url = "$UPSTREAM"
[models.team-model]
label = "Team Model"
[models.chat-only]
label = "Chat Only"
[routes.team-route]
account = "team"
model = "team-model"
upstream_model = "team-model"
interfaces = { anthropic = ["tool_search"] }
[routes.mixed-chat]
account = "mixed"
model = "chat-only"
upstream_model = "chat-only"
interfaces = { openai_chat_completions = [] }
-- help.txt --
AIGW  aigw provider
────────────────────────────────────────
  List, show, add, edit and remove providers; rotate Tokens; report balances

Usage
  aigw provider [command]

Commands
  add                  Add a provider with its endpoints and a Token that it accepts
  balance              Report the balance and Token quota of every provider, or of those named
  edit                 Change a provider's label, endpoints or balance credentials; its Token stays
  list                 List the providers; reads no Token and sends no request
  remove               Remove a provider with its models, Token and balance credentials
  rotate               Replace a provider's Token with one that the provider accepts
  show                 Show one provider: its endpoints, its models and whether its Token is stored

Options
  -h, --help   help for provider
-- add-help.txt --
AIGW  aigw provider add
────────────────────────────────────────
  Add a provider with its endpoints and a Token that it accepts.
  AIGW sends one authenticated request that names no model, and stores the Token only when the provider accepts it.

Usage
  aigw provider add <provider> [flags]

Examples
  aigw provider add dmxapi --endpoint responses=https://www.dmxapi.cn/v1 --token-stdin
  aigw provider add ucloud --label UCloud --endpoint anthropic=https://api.modelverse.cn
  aigw provider add dmxapi --endpoint responses=https://www.dmxapi.cn/v1 --dry-run

Options
      --dry-run                     Show the provider without reading a Token, sending a request or writing anything
      --endpoint <protocol>=<url>   An endpoint of the provider as <protocol>=<url>; repeatable: anthropic, responses, or chat
  -h, --help                        help for add
      --json                        Write the added provider as JSON
      --label string                Display name; the provider ID by default
      --token-stdin                 Read the Token from standard input
-- rotated.txt --
AIGW  Token replaced
────────────────────────────────────────
  Provider             team
  Label                Team Gateway
  ✓ Token              Accepted by the provider and stored
  ✓ Clients read the new Token the next time they ask for one; a running client decides when that is

Next
  aigw check
