# credential refuses an unsupported client without writing to stdout, and
# the helper that AIGW projects into Claude Code returns the Account Token.
exec aigw credential --help
cmp stdout help.txt

exitcode 1 aigw credential unsupported
! stdout .
normalize stderr refusal.out
cmp refusal.out refusal.txt

stdin token.txt
exec aigw add team --label 'Team Gateway' --anthropic-url $UPSTREAM --upstream-model team-model --for claude --token-stdin
apikeyhelper $HOME/.claude/settings.json
stdout '^sk-team-token-0001$'
normalize stderr helper.err
! grep . helper.err

-- token.txt --
sk-team-token-0001
-- help.txt --
AIGW  aigw credential
────────────────────────────────────────
  Read the Account Token matching a client projection

Usage
  aigw credential <client> <projection-fingerprint> [flags]

Options
  -h, --help   help for credential
-- refusal.txt --
AIGW  Action required
────────────────────────────────────────

Problem
  Credential helper could not complete

Impact
  No usable credential was returned.

Recommended action
  Check the AIGW configuration and credential backend; run `aigw sync` and reload the client's configuration.
