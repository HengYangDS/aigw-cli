# credential refuses an unsupported client and a flag that it does not accept
# without writing to stdout, and the helper that AIGW projects into Claude Code
# returns the Account Token.
exec aigw credential --help
cmp stdout help.txt

# The credential helper writes no JSON, so fixloop cannot follow its
# refusals.
exitcode 1 aigw credential unsupported
! stdout .
normalize stderr refusal.out
cmp refusal.out refusal.txt
# A flag that the helper does not accept gets the same refusal.
exitcode 1 aigw credential --not-a-flag
! stdout .
normalize stderr flag-refusal.out
cmp flag-refusal.out refusal.txt

stdin token.txt
exec aigw provider add team --label 'Team Gateway' --endpoint anthropic=$UPSTREAM --token-stdin
exec aigw use claude team/team-model
apikeyhelper $HOME/.claude/settings.json
stdout '^sk-team-token-0001$'
normalize stderr helper.err
! grep . helper.err

-- token.txt --
sk-team-token-0001
-- help.txt --
AIGW  aigw credential
────────────────────────────────────────
  Read the provider Token that a client file's fingerprint names

Usage
  aigw credential <client> <fingerprint> [flags]

Options
  -h, --help[=true|false]   help for credential
-- refusal.txt --
AIGW  Action required
────────────────────────────────────────

Problem
  Credential helper could not complete

Impact
  No usable credential was returned.

Fix
  Check the AIGW configuration and credential backend; run `aigw sync` and reload the client's configuration.
