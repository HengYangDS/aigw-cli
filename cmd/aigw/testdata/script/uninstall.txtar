# uninstall removes an installed program, reports a program that is already
# gone as JSON, and refuses a directory as the target, in text and as JSON.
exec aigw uninstall --help
cmp stdout help.txt

exec aigw install --target $WORK/bin/aigw$exe
exec aigw uninstall --target $WORK/bin/aigw$exe
cmp stdout removed.txt
! exists $WORK/bin/aigw$exe

exec aigw install --target $WORK/json/aigw$exe
exec aigw uninstall --target $WORK/json/aigw$exe --json
normalize stdout removed-json.out
[!windows] cmp removed-json.out removed.json
[windows] cmp removed-json.out removed-windows.json
! exists $WORK/json/aigw$exe
exec aigw uninstall --target $WORK/json/aigw$exe --json
normalize stdout absent-json.out
[!windows] cmp absent-json.out absent.json
[windows] cmp absent-json.out absent-windows.json

exitcode 1 aigw uninstall --target $WORK
normalize stdout refusal.out
cmp refusal.out refusal.txt
exitcode 1 aigw uninstall --target $WORK --json
normalize stdout json-refusal.out
cmp json-refusal.out json-refusal.json

-- help.txt --
AIGW  aigw uninstall
────────────────────────────────────────
  Withdraw AIGW-owned client projections, then remove the portable
  executable and its rollback copy. This retains Account and Route data
  and stored Tokens. Homebrew-managed copies must be removed with
  Homebrew; this command does not manage them.

Usage
  aigw uninstall [flags]

Options
  -h, --help            help for uninstall
      --json            Write the removal as JSON
      --target string   installed executable path; defaults to the running executable
-- removed.txt --
AIGW  Portable uninstall
────────────────────────────────────────
  ✓ Removed AIGW client projections, executable, and its single rollback copy
  Configuration and credential-store secrets were preserved.
  Versioned credential readers were retained for cached or other-installation callers.
-- refusal.txt --
AIGW  Action required
────────────────────────────────────────

Problem
  Portable program removal is incomplete

Evidence
  AIGW could not remove every selected portable program file.

Impact
  No AIGW configuration existed; no managed client withdrawal was needed. Tokens and versioned credential readers are retained.

Recommended action
  Inspect the selected target and retained files; after resolving file access, retry `uninstall --target <path>` from another verified AIGW executable.
-- removed.json --
{
  "schema_version": 1,
  "ok": true,
  "path": "$WORK/json/aigw",
  "program_found": true,
  "withdrawn_clients": []
}
-- absent.json --
{
  "schema_version": 1,
  "ok": true,
  "path": "$WORK/json/aigw",
  "program_found": false,
  "withdrawn_clients": []
}
-- json-refusal.json --
{
  "schema_version": 1,
  "ok": false,
  "error": "Portable program removal is incomplete",
  "evidence": "AIGW could not remove every selected portable program file.",
  "impact": "No AIGW configuration existed; no managed client withdrawal was needed. Tokens and versioned credential readers are retained.",
  "next_action": "Inspect the selected target and retained files; after resolving file access, retry `uninstall --target \u003cpath\u003e` from another verified AIGW executable."
}
-- removed-windows.json --
{
  "schema_version": 1,
  "ok": true,
  "path": "$WORK/json/aigw.exe",
  "program_found": true,
  "withdrawn_clients": []
}
-- absent-windows.json --
{
  "schema_version": 1,
  "ok": true,
  "path": "$WORK/json/aigw.exe",
  "program_found": false,
  "withdrawn_clients": []
}
