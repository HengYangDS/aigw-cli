# uninstall removes an installed program, reports a program that is already
# gone as JSON, and refuses a directory as the target, in text and as JSON.
exec aigw uninstall --help
cmp stdout help.txt

exec aigw install --path $WORK/bin/aigw$exe
exec aigw uninstall --path $WORK/bin/aigw$exe
cmp stdout removed.txt
! exists $WORK/bin/aigw$exe

exec aigw install --path $WORK/json/aigw$exe
exec aigw uninstall --path $WORK/json/aigw$exe --json
normalize stdout removed-json.out
[!windows] cmp removed-json.out removed.json
[windows] cmp removed-json.out removed-windows.json
! exists $WORK/json/aigw$exe
exec aigw uninstall --path $WORK/json/aigw$exe --json
normalize stdout absent-json.out
[!windows] cmp absent-json.out absent.json
[windows] cmp absent-json.out absent-windows.json

# A preview names the files that it would remove and keeps them.
exec aigw install --path $WORK/preview/aigw$exe
snapshot $WORK/preview before.txt
exec aigw uninstall --path $WORK/preview/aigw$exe --dry-run --json
normalize stdout uninstall-preview.out
[!windows] cmp uninstall-preview.out uninstall-preview.json
[windows] cmp uninstall-preview.out uninstall-preview-windows.json
exec aigw uninstall --path $WORK/preview/aigw$exe --dry-run
stdout 'Portable uninstall preview'
stdout 'Remove +'
stdout 'Preview did not write'
exec aigw uninstall --path $WORK/absent/aigw$exe --dry-run
stdout 'No program file at'
# The spelling that 0.5.0 hid is an unknown flag now, and removes nothing.
exitcode 1 aigw uninstall --target $WORK/preview/aigw$exe
cmp stdout spellings.txt
snapshot $WORK/preview after.txt
cmp after.txt before.txt

exitcode 1 aigw uninstall --path $WORK
normalize stdout refusal.out
cmp refusal.out refusal.txt
exitcode 1 aigw uninstall --path $WORK --json
normalize stdout json-refusal.out
cmp json-refusal.out json-refusal.json

-- uninstall-preview.json --
{
  "schema_version": 1,
  "ok": true,
  "dry_run": true,
  "path": "$WORK/preview/aigw",
  "program_found": true,
  "withdrawn_clients": [],
  "removed": [
    "$WORK/preview/aigw"
  ],
  "next_action": "aigw uninstall --path $WORK/preview/aigw"
}
-- uninstall-preview-windows.json --
{
  "schema_version": 1,
  "ok": true,
  "dry_run": true,
  "path": "$WORK/preview/aigw.exe",
  "program_found": true,
  "withdrawn_clients": [],
  "removed": [
    "$WORK/preview/aigw.exe"
  ],
  "next_action": "aigw uninstall --path $WORK/preview/aigw.exe"
}
-- spellings.txt --
AIGW  Action required
────────────────────────────────────────

Problem
  unknown option --target; run `aigw uninstall --help`

Impact
  The command could not finish; inspect current state before retrying.

Recommended action
  aigw uninstall --help
-- help.txt --
AIGW  aigw uninstall
────────────────────────────────────────
  Withdraw AIGW-owned client projections, then remove the portable
  executable and its rollback copy. This retains Account and Route data
  and stored Tokens. Homebrew-managed copies must be removed with
  Homebrew; this command does not manage them.

Usage
  aigw uninstall [flags]

Options
      --dry-run       Show the client files and program files that uninstalling would change or remove without changing them
  -h, --help          help for uninstall
      --json          Write the removal as JSON
      --path string   installed executable path; defaults to the running executable
-- removed.txt --
AIGW  Portable uninstall
────────────────────────────────────────
  ✓ Removed AIGW client projections, executable, and its single rollback copy
  Configuration and credential-store secrets were preserved.
  Versioned credential readers were retained for cached or other-installation callers.
-- refusal.txt --
AIGW  Action required
────────────────────────────────────────

Problem
  portable AIGW file $WORK is a directory; name the program file

Impact
  The command could not finish; inspect current state before retrying.

Recommended action
  aigw check
-- removed.json --
{
  "schema_version": 1,
  "ok": true,
  "path": "$WORK/json/aigw",
  "program_found": true,
  "withdrawn_clients": []
}
-- absent.json --
{
  "schema_version": 1,
  "ok": true,
  "path": "$WORK/json/aigw",
  "program_found": false,
  "withdrawn_clients": []
}
-- json-refusal.json --
{
  "schema_version": 2,
  "ok": false,
  "error": "portable AIGW file $WORK is a directory; name the program file",
  "impact": "The command could not finish; inspect current state before retrying.",
  "next_action": "aigw check"
}
-- removed-windows.json --
{
  "schema_version": 1,
  "ok": true,
  "path": "$WORK/json/aigw.exe",
  "program_found": true,
  "withdrawn_clients": []
}
-- absent-windows.json --
{
  "schema_version": 1,
  "ok": true,
  "path": "$WORK/json/aigw.exe",
  "program_found": false,
  "withdrawn_clients": []
}
