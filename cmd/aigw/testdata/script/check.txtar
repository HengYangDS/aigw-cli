# check refuses an empty home, then checks the connected client with one
# inference request, as JSON and in text.
exec aigw check --help
cmp stdout help.txt

exitcode 1 aigw check
cmp stdout empty.txt
exitcode 1 aigw check --json
cmp stdout empty.json

stdin token.txt
exec aigw add team --label 'Team Gateway' --anthropic-url $UPSTREAM --model team-model --for claude --token-stdin
exec aigw check --json
cmp stdout checked.json
exec aigw check
cmp stdout checked.txt
exitcode 1 aigw check --for codex
cmp stdout codex.txt

-- token.txt --
sk-team-token-0001
-- help.txt --
AIGW  aigw check
────────────────────────────────────────
  Check every enabled client by default, or one with --for.
  Inspect its binding, credential, and native projection.
  For AIGW-managed Tokens, the default sends one bounded selected-model
  inference request per eligible client and may use provider quota.
  Use --endpoint-only for a model-free authenticated endpoint request.
  This command does not execute a native client or change configuration;
  use verify for real-client evidence.

Usage
  aigw check [flags]

Options
      --endpoint-only   Use model-free endpoint authentication instead of inference
      --for string      Check one enabled client: claude, claude-desktop, codex, or hermes; omit for all
  -h, --help            help for check
      --json            Write machine-readable JSON
-- empty.txt --
AIGW  Action required
────────────────────────────────────────

Problem
  Not configured

Evidence
  No Routes have been created.

Impact
  Cannot check, synchronize, or repair configuration that does not exist.

Recommended action
  aigw setup
-- empty.json --
{
  "clients": {},
  "enabled_clients": 0,
  "ok": false,
  "state": "deferred",
  "next_action": "aigw setup",
  "error": "not configured"
}
