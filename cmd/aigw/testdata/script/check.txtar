# check climbs one ladder of evidence for each checked client: local without
# a request, endpoint with one request that names no model, model, the
# default, with one inference request, and client with a real session. A
# client stops at its first failed depth while the others climb, and a depth
# that a client cannot run is skipped with the reason, which fails nothing. A
# named disabled client is checked without client files, a check that names no
# client while none is enabled fails without a request, --verbose prints every
# local check, --model tries a model without selecting it, with a one-time
# Token through --token-stdin, a check of every enabled client to the client
# depth writes the verified snapshot with each client's depth, and a
# configuration that does not load names its stage.
exec aigw check --help
cmp stdout help.txt

# Without configuration no client is enabled, and nothing is sent.
exitcode 1 aigw check
cmp stdout empty.txt
exitcode 1 aigw check --json
cmp stdout empty.json

stdin token.txt
exec aigw provider add team --label 'Team Gateway' --endpoint anthropic=$UPSTREAM --token-stdin
exec aigw use claude team/team-model

# Each depth runs the ones before it.
exec aigw check --depth local --json
cmp stdout local.json
exec aigw check --depth endpoint
cmp stdout endpoint.txt
exec aigw check
cmp stdout model.txt
exec aigw check --depth client
cmp stdout client.txt
exec aigw check --depth local --verbose
cmp stdout verbose.txt

# A named model is tried without selecting it, with a one-time Token from
# standard input, which is neither read from nor written to the store: the
# home is unchanged.
exec aigw model add team/spare-model --protocol anthropic
snapshot $HOME before-once.txt
stdin once.txt
exec aigw check claude --model team/spare-model --token-stdin --depth endpoint --json
cmp stdout once.json
snapshot $HOME after-once.txt
cmp after-once.txt before-once.txt

# Claude Code that keeps its own model preference has no model depth: AIGW
# does not choose the model that it sends. The deeper check is a session.
jsonset $HOME/.claude/settings.json model '"opus[1m]"'
exec aigw check --json
cmp stdout native.json
jsonset $HOME/.claude/settings.json model '"team-model"'

# Claude Desktop needs acceptance inside the app, so its client depth is
# skipped; the check passes. A provider that fails stops only its client.
exec aigw use claude-desktop team/team-model
# Claude Desktop keeps its standard configuration two levels above its
# library, so the library sits two levels below $WORK: every script's files
# stay inside its own $WORK.
exec aigw client edit claude-desktop --executable $BIN/claude$exe --target $WORK/desktop/Claude-3p/configLibrary
exec aigw check claude-desktop --depth client
cmp stdout desktop.txt

# A check of every enabled client to the client depth writes the verified
# snapshot, with the depth that each client reached: Claude Code's session
# completes, and Claude Desktop reaches the model depth. A check of named
# clients writes none.
exec aigw check claude claude-desktop --depth client --json
stdout '"snapshot_written": false'
[darwin] ! exists $HOME/Library/Application' 'Support/aigw/config.toml.verified.json
[!darwin] ! exists $HOME/aigw/config.toml.verified.json
exec aigw check --depth client
cmp stdout snapshot.txt
[darwin] cp $HOME/Library/Application' 'Support/aigw/config.toml.verified.json verified.json
[!darwin] cp $HOME/aigw/config.toml.verified.json verified.json
grep '"client": "claude",\n\s+"depth": "client"' verified.json
grep '"client": "claude-desktop",\n\s+"depth": "model"' verified.json
# A client that stops leaves the verified snapshot as it was: here a variable
# that competes with AIGW's Token stops every client at the local depth.
env ANTHROPIC_API_KEY=sk-other-0003
exitcode 1 aigw check --depth client --json
stdout '"snapshot_written": false'
stdout '"problem": "2 of 2 checked clients stopped before the client depth"'
[darwin] cmp $HOME/Library/Application' 'Support/aigw/config.toml.verified.json verified.json
[!darwin] cmp $HOME/aigw/config.toml.verified.json verified.json
env ANTHROPIC_API_KEY=
stdin token.txt
exec aigw provider add down --label 'Down Gateway' --endpoint anthropic=$UPSTREAM --token-stdin
exec aigw use claude-desktop down/team-model
exec aigw provider edit down --endpoint anthropic=$UPSTREAM/unavailable
exitcode 1 aigw check
cmp stdout down.txt
exitcode 1 aigw check --json
cmp stdout down.json

# A named disabled client is checked without client files, and with none
# enabled a check without a client argument fails before any request.
exec aigw client disable claude-desktop
exec aigw client disable claude
exec aigw check claude --depth client --json
cmp stdout disabled.json
exitcode 1 aigw check --depth local
cmp stdout none-enabled.txt
# Its fix runs as printed and enables the client again.
exec aigw use claude team/team-model
exec aigw check --depth local
stdout '✓ Claude             team/team-model · local'

[darwin] cp broken.toml $HOME/Library/Application' 'Support/aigw/config.toml
[!darwin] cp broken.toml $HOME/aigw/config.toml
exitcode 1 aigw check --json
cmp stdout broken.json

-- token.txt --
sk-team-token-0001
-- once.txt --
sk-once-token-0002
-- once.json --
