# install copies the running program to a target and refuses a directory as
# the target, in text and as JSON. The help quotes its default path, so on
# Windows each separator appears as two backslashes.
exec aigw install --help
normalize stdout help.out
[!windows] cmp help.out help.txt
[windows] cmp help.out help-windows.txt

exec aigw install --path $WORK/bin/aigw$exe
normalize stdout installed.out
[!windows] cmp installed.out installed.txt
[windows] cmp installed.out installed-windows.txt
exists $WORK/bin/aigw$exe

exec aigw install --path $WORK/json/aigw$exe --json
normalize stdout installed-json.out
[!windows] cmp installed-json.out installed.json
[windows] cmp installed-json.out installed-windows.json
exists $WORK/json/aigw$exe

# Previews write neither the program nor its directory.
exec aigw install --path $WORK/preview/aigw$exe --dry-run --json
normalize stdout install-preview.out
[!windows] cmp install-preview.out install-preview.json
[windows] cmp install-preview.out install-preview-windows.json
! exists $WORK/preview
snapshot $WORK/bin bin-before.txt
exec aigw install --path $WORK/bin/aigw$exe --dry-run
normalize stdout unchanged-preview.out
[!windows] cmp unchanged-preview.out unchanged-preview.txt
[windows] cmp unchanged-preview.out unchanged-preview-windows.txt
# The spelling that 0.5.0 hid is an unknown flag now, and installs nothing.
exitcode 1 aigw install --target $WORK/one/aigw$exe
cmp stdout spellings.txt
snapshot $WORK/bin bin-after.txt
cmp bin-after.txt bin-before.txt
! exists $WORK/one

# A preview over another program names the rollback copy and writes neither.
mkdir $WORK/other
cp old-program.txt $WORK/other/aigw$exe
snapshot $WORK/other other-before.txt
exec aigw install --path $WORK/other/aigw$exe --dry-run --json
normalize stdout replace-preview.out
[!windows] cmp replace-preview.out replace-preview.json
[windows] cmp replace-preview.out replace-preview-windows.json
exec aigw install --path $WORK/other/aigw$exe --dry-run
stdout 'Rollback copy'
stdout 'with this same program'
snapshot $WORK/other other-after.txt
cmp other-after.txt other-before.txt
# A directory as the target names the program file inside it, in prose,
# because `aigw` on PATH may be another program. A preview stays a preview, and
# the command that the refusal names succeeds.
exitcode 1 aigw install --path $WORK --dry-run
stdout 'aigw install --dry-run --path'

exitcode 1 aigw install --path $WORK
normalize stdout refusal.out
[!windows] cmp refusal.out refusal.txt
[windows] cmp refusal.out refusal-windows.txt
exitcode 1 aigw install --path $WORK --json
normalize stdout json-refusal.out
[!windows] cmp json-refusal.out json-refusal.json
[windows] cmp json-refusal.out json-refusal-windows.json
exec aigw install --path $WORK${/}aigw$exe
exists $WORK/aigw$exe

# When the file that it would name is a directory too, or a word would need
# quoting, the refusal names no command, and a target that the command cannot
# use is named with its cause and never a local check.
mkdir $WORK/nested/aigw$exe
exitcode 1 aigw install --path $WORK/nested
stdout 'naming a program file'
! stdout 'aigw install --path'
mkdir $WORK/with' 'space
exitcode 1 aigw install --path $WORK/with' 'space
stdout 'naming the program file'
! stdout 'aigw install --path'
cp blocker.txt $WORK/blocked
exitcode 1 aigw install --path $WORK/blocked/aigw$exe
stdout 'then run the same command again'
! stdout 'aigw check'

-- install-preview.json --
{
  "schema_version": 1,
  "ok": true,
  "dry_run": true,
  "path": "$WORK/preview/aigw",
  "version": "0.1.0-dev",
  "creates_folder": "$WORK/preview",
  "next_detail": "Run the same command with this same program, without --dry-run, to apply this plan; `aigw` on PATH may be another program."
}
-- install-preview-windows.json --
{
  "schema_version": 1,
  "ok": true,
  "dry_run": true,
  "path": "$WORK/preview/aigw.exe",
  "version": "0.1.0-dev",
  "creates_folder": "$WORK/preview",
  "next_detail": "Run the same command with this same program, without --dry-run, to apply this plan; `aigw` on PATH may be another program."
}
-- unchanged-preview.txt --
AIGW  Portable installation preview
────────────────────────────────────────
  Program file         $WORK/bin/aigw
  Version              0.1.0-dev
  ✓ Installed          Already this program; installing again only makes it executable
  ✓ Preview did not write the program, a rollback copy or a directory
  PATH is unchanged. Use the installed path directly, or add its directory to PATH before running `aigw setup`.
-- unchanged-preview-windows.txt --
AIGW  Portable installation preview
────────────────────────────────────────
  Program file         $WORK/bin/aigw.exe
  Version              0.1.0-dev
  ✓ Installed          Already this program; installing again only makes it executable
  ✓ Preview did not write the program, a rollback copy or a directory
  PATH is unchanged. Use the installed path directly, or add its directory to PATH before running `aigw setup`.
-- spellings.txt --
AIGW  Action required
────────────────────────────────────────

Problem
  unknown option --target; run `aigw install --help`

Fix
  aigw install --help
-- replace-preview.json --
{
  "schema_version": 1,
  "ok": true,
  "dry_run": true,
  "path": "$WORK/other/aigw",
  "version": "0.1.0-dev",
  "rollback": "$WORK/other/.aigw.previous",
  "next_detail": "Run the same command with this same program, without --dry-run, to apply this plan; `aigw` on PATH may be another program."
}
-- replace-preview-windows.json --
{
  "schema_version": 1,
  "ok": true,
  "dry_run": true,
  "path": "$WORK/other/aigw.exe",
  "version": "0.1.0-dev",
  "rollback": "$WORK/other/.aigw.previous.exe",
  "next_detail": "Run the same command with this same program, without --dry-run, to apply this plan; `aigw` on PATH may be another program."
}
-- old-program.txt --
another program
-- help.txt --
AIGW  aigw install
────────────────────────────────────────
  Install this portable AIGW executable

Usage
