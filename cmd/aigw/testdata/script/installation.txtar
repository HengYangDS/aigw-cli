# installation describes the running program, as JSON and in text, and
# refuses an argument.
exec aigw installation --help
cmp stdout help.txt

# The payload's digest and size vary with the build.
exec aigw installation --json
normalize stdout installation.out '[0-9a-f]{64}' '[0-9]{5,}'
[!windows] cmp installation.out installation.json
[windows] cmp installation.out installation-windows.json
exec aigw installation
stdout 'Version +0\.1\.0-dev'

exitcode 1 aigw installation extra
cmp stdout refusal.txt
exitcode 1 aigw installation extra --json
cmp stdout refusal.json

-- help.txt --
AIGW  aigw installation
────────────────────────────────────────
  Observe program paths, byte counts and SHA-256 without changing files or reading Account configuration. This does not verify release trust, rollback readiness or client connectivity.

Usage
  aigw installation [flags]

Options
  -h, --help   help for installation
      --json   Write machine-readable JSON
-- refusal.txt --
AIGW  Action required
────────────────────────────────────────

Problem
  unknown command "extra"

Impact
  The command could not finish; inspect current state before retrying.

Recommended action
  aigw --help
-- refusal.json --
{
  "schema_version": 2,
  "ok": false,
  "error": "unknown command \"extra\"",
  "impact": "The command could not finish; inspect current state before retrying.",
  "next_action": "aigw --help"
}
-- installation.json --
{
  "schema_version": 1,
  "ok": true,
  "version": "0.1.0-dev",
  "command_path": "$BIN/aigw",
  "payload": {
    "path": "$BIN/aigw",
    "sha256": "<varies>",
    "size_bytes": <varies>
  },
  "rollback": null
}
-- installation-windows.json --
{
  "schema_version": 1,
  "ok": true,
  "version": "0.1.0-dev",
  "command_path": "$BIN\\aigw.exe",
  "payload": {
    "path": "$BIN\\aigw.exe",
    "sha256": "<varies>",
    "size_bytes": <varies>
  },
  "rollback": null
}
