# The root help lists the command groups, the version flag reports the
# version, and an unknown command is refused.
exec aigw --help
cmp stdout help.txt
normalize stderr help.err
! grep . help.err

exec aigw --version
cmp stdout version.txt

# Bare aigw is aigw status: without a configuration it names aigw setup, and
# with one it shows each client's model.
exec aigw
cmp stdout bare-empty.txt
exec aigw status
cmp stdout bare-empty.txt
stdin token.txt
exec aigw provider add team --endpoint anthropic=$UPSTREAM --token-stdin
exec aigw use claude team/team-model
exec aigw
cp stdout bare.txt
stdout 'Claude +team/team-model'
exec aigw status
cmp stdout bare.txt

exitcode 1 aigw nothing
cmp stdout unknown.txt
# An unknown command reports in text even with --json, so fixloop cannot
# follow its fix.

# The commands that the tree replaced are unknown: each names aigw --help and
# changes nothing.
snapshot $HOME removed-before.txt
exitcode 1 aigw install
stdout 'unknown command "install"'
stdout '^  aigw --help$'
exitcode 1 aigw installation
stdout 'unknown command "installation"'
exitcode 1 aigw update --rollback
stdout 'unknown command "update"'
exitcode 1 aigw uninstall
stdout 'unknown command "uninstall"'
exitcode 1 aigw repair
stdout 'unknown command "repair"'
exitcode 1 aigw rollback --last-change
stdout 'unknown command "rollback"'
exitcode 1 aigw doctor
stdout 'unknown command "doctor"'
exitcode 1 aigw test
stdout 'unknown command "test"'
exitcode 1 aigw verify --for claude
stdout 'unknown command "verify"'
exitcode 1 aigw catalog --all
stdout 'unknown command "catalog"'
exitcode 1 aigw models
stdout 'unknown command "models"'
exitcode 1 aigw route list
stdout 'unknown command "route"'
exitcode 1 aigw account rename old new
stdout 'unknown command "account"'
exitcode 1 aigw add team --for claude
stdout 'unknown command "add"'
exitcode 1 aigw rotate team
stdout 'unknown command "rotate"'
exitcode 1 aigw balance
stdout 'unknown command "balance"'
snapshot $HOME removed-after.txt
cmp removed-after.txt removed-before.txt

-- help.txt --
AIGW  Command help
────────────────────────────────────────
  Local AI provider configuration, routing, and diagnostics

Start with one path
  aigw setup                          Connect the first account
  aigw use <client> <provider/model>  Point a client at a model
  aigw check                          Check enabled clients (may use quota)

Usage
  aigw [flags]
  aigw [command]

Connect
  setup                Set up a provider, a client and a model, or apply a team file

Use every day
  check                Check that each client works, as deep as --depth asks
  status               Show each client's model and local readiness
  use                  Point a client at a model

Recover
  self                 Install, update, roll back, remove or inspect this program
  sync                 Make client files match the configuration

Advanced
  client               List, enable, disable and edit clients
  completion           Generate shell completion
  config               Show, export and roll back the configuration
  model                List, search, show, add, edit and remove models
  provider             List, show, add, edit and remove providers; rotate Tokens; report balances
  version              Show the program's version

Options
  -h, --help      show help
  -v, --version   show version
-- version.txt --
aigw version 0.1.0-dev
-- unknown.txt --
AIGW  Action required
────────────────────────────────────────

Problem
  unknown command "nothing"

Fix
  aigw --help
-- bare-empty.txt --
AIGW  Not configured
────────────────────────────────────────

Get started
  Run the guided setup once to add a provider, its Token and a first model.

Next
  aigw setup
-- token.txt --
sk-team-token-0001
