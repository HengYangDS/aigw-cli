# model lists, shows, adds, edits and removes the models that the
# configuration holds, each named provider/model, and searches the providers'
# catalogs. Each subcommand writes JSON, each write previews without writing
# anything, and the refusals name their own fix: the catalog check names
# --unlisted or the closest listed ID, a protocol that the provider does not
# serve is refused, an edit keeps the protocols that a client or a
# recommendation uses, a name with a model per protocol is selected with
# --protocol, a model that a client uses is not removed, and search names the
# fix of each catalog that it could not read while the others print.
exec aigw model --help
cmp stdout help.txt
exec aigw model add --help
cmp stdout add-help.txt

# The team provider serves Anthropic Messages from the scripted upstream, which
# lists team-model and spare-model. The mixed provider has two endpoints, no
# Token, so its catalog cannot be read, and a recommendation for Hermes.
stdin token.txt
exec aigw add team --label 'Team Gateway' --anthropic-url $UPSTREAM --upstream-model team-model --for claude --token-stdin
envsubst mixed.in mixed.toml
exec aigw config import mixed.toml

exec aigw model list
cmp stdout list.txt
exec aigw model list --json
cmp stdout list.json
exec aigw model list gateway --provider team --client claude --protocol anthropic --json
cmp stdout list-filtered.json
exitcode 1 aigw model list --client codx --json
cmp stdout list-client-refusal.json

exec aigw model show team/team-model --json
normalize stdout show.out
cmp show.out show.json
exitcode 1 aigw model show team-model
cmp stdout show-bare.txt
exitcode 1 aigw model show tem/team-model --json
cmp stdout show-provider.json
exitcode 1 aigw model show team/team-mdl --json
cmp stdout show-model.json

# Previews read no catalog and write nothing below the private home.
snapshot $HOME before.txt
exec aigw model add team/spare-model --dry-run
cmp stdout add-preview.txt
exec aigw model add team/spare-model --dry-run --json
cmp stdout add-preview.json
exec aigw model edit team/team-model --label 'Team Model' --dry-run --json
cmp stdout edit-preview.json
exec aigw model remove mixed/chat-only --dry-run --json
cmp stdout remove-preview.json
snapshot $HOME after.txt
cmp after.txt before.txt

# The catalog does not list spare-mdl, and the fix adds the closest listed ID
# that is not added yet; it lists spare-model, so that is added. The mixed
# provider's catalog cannot be read.
exitcode 1 aigw model add team/spare-mdl
cmp stdout add-unlisted.txt
exec aigw model add team/spare-model --capability tool_search --json
cmp stdout added.json
# A typo of an added model names that model; it is never added as typed.
exitcode 1 aigw model add team/team-modl --json
cmp stdout add-added-typo.json
exitcode 1 aigw model add mixed/new-model --protocol chat --json
cmp stdout add-unreadable.json
exec aigw model add mixed/new-model --protocol chat --unlisted --family new-family --json
cmp stdout add-forced.json

# A provider with several endpoints needs --protocol, a protocol must be one
# that the provider serves and that the command line names, and an existing
# model is refused.
exitcode 1 aigw model add mixed/other-model --unlisted
cmp stdout add-protocol.txt
exitcode 1 aigw model add team/other-model --protocol responses --unlisted --json
cmp stdout add-endpoint.json
exitcode 1 aigw model add team/other-model --protocol openai_responses --unlisted
cmp stdout add-spelling.txt
exitcode 1 aigw model add team/team-model --unlisted --json
cmp stdout add-exists.json

# An edit replaces each set that it is given and keeps the protocol that a
# client uses.
exec aigw model edit mixed/new-model --protocol chat --protocol anthropic --capability tool_search --json
cmp stdout edited.json
exec aigw model edit mixed/new-model --capability '' --label '' --json
cmp stdout cleared.json
exitcode 1 aigw model edit team/team-model --json
cmp stdout edit-nothing.json
exitcode 1 aigw model edit team/team-model --json --protocol openai_chat_completions
cmp stdout edit-spelling.json
exitcode 1 aigw model edit mixed/chat-only --capability tool_search
cmp stdout edit-capability.txt
exitcode 1 aigw model edit mixed/spare-chat --protocol anthropic --json
cmp stdout edit-recommended.json
stdin mixed-token.txt
exec aigw rotate mixed --token-stdin
exec aigw use --for hermes mixed-chat
exitcode 1 aigw model edit mixed/chat-only --protocol anthropic --json
cmp stdout edit-selected.json

# The team file gives mixed/twin a Route on each of two protocols: show
# refuses the name and names --protocol, which selects one.
exitcode 1 aigw model show mixed/twin --json
cmp stdout show-twin.json
exec aigw model show mixed/twin --protocol anthropic --json
normalize stdout show-twin-anthropic.out
cmp show-twin-anthropic.out show-twin-anthropic.json
exec aigw model list twin
cmp stdout list-twin.txt

# A model that any client uses is not removed, even by a disabled client;
# another one is, and the recommendation that names it drops it.
exitcode 1 aigw model remove team/team-model --json
cmp stdout remove-selected.json
# --protocol selects only a model that declares it.
exitcode 1 aigw model remove mixed/chat-only --protocol anthropic --json
cmp stdout remove-protocol.json
exec aigw client disable hermes
exitcode 1 aigw model remove mixed/chat-only
cmp stdout remove-disabled.txt
exec aigw model remove mixed/spare-chat --json
cmp stdout removed.json
exec aigw model list --provider mixed
cmp stdout list-mixed.txt

# search reads the catalogs: team's lists both of its models, and mixed's,
# read on both of its protocols, lists none of its own, which are missing,
# and two that it could add.
envsubst search.in search.toml
exec aigw config import search.toml
stdin fresh-token.txt
exec aigw provider rotate fresh --token-stdin
exec aigw model search --help
cmp stdout search-help.txt
exec aigw model search --provider team --provider mixed --json
normalize stdout search.out
cmp search.out search.json
exec aigw model search spare --provider team
cmp stdout search-query.txt
# bare has no Token, and fresh is read on Anthropic Messages but not on Chat
# Completions: it shows what it got, reports no model missing and names the
# failed source, while the other providers still print.
exitcode 1 aigw model search
normalize stdout search-failed.out
cmp search-failed.out search-failed.txt
exitcode 1 aigw model search --provider fresh --json
normalize stdout search-partial.out
cmp search-partial.out search-partial.json
exitcode 1 aigw model search --provider tem --json
cmp stdout search-unknown.json
# The environment backend supplies broken's Token, and its catalog fails.
env AIGW_SECRET_BACKEND=env
env AIGW_TOKEN_BROKEN=sk-broken-token-0001
exitcode 1 aigw model search --provider broken --json
normalize stdout search-unreadable.out
cmp search-unreadable.out search-unreadable.json

-- token.txt --
sk-team-token-0001
-- mixed-token.txt --
sk-mixed-token-0001
-- fresh-token.txt --
sk-fresh-token-0001
-- search.in --
version = 7
[accounts.fresh]
label = "Fresh"
[accounts.fresh.endpoints]
anthropic = "$UPSTREAM/fresh"
openai_chat_completions = "$UPSTREAM/unavailable/v1"
[accounts.bare]
label = "Bare"
[accounts.bare.endpoints]
anthropic = "$UPSTREAM/bare"
[accounts.broken]
label = "Broken"
[accounts.broken.endpoints]
openai_responses = "$UPSTREAM/unavailable/v1"
[models.fresh-old]
label = "Fresh Old"
[models.gone-model]
label = "Gone Model"
[models.bare-model]
label = "Bare Model"
[models.broken-model]
label = "Broken Model"
[routes.fresh-old]
account = "fresh"
model = "fresh-old"
upstream_model = "team-model"
lifecycle = "deprecated"
interfaces = { anthropic = [] }
[routes.fresh-gone]
account = "fresh"
model = "gone-model"
upstream_model = "gone-model"
interfaces = { anthropic = [] }
[routes.bare-route]
account = "bare"
model = "bare-model"
upstream_model = "bare-model"
interfaces = { anthropic = [] }
[routes.broken-route]
account = "broken"
model = "broken-model"
upstream_model = "broken-model"
interfaces = { openai_responses = [] }
-- mixed.in --
version = 7
[recommendations.hermes.primary]
route = "mixed-spare"
protocol = "openai_chat_completions"
[[recommendations.hermes.alternatives]]
route = "mixed-chat"
protocol = "openai_chat_completions"
[accounts.mixed]
label = "Mixed"
[accounts.mixed.endpoints]
anthropic = "$UPSTREAM/mixed"
openai_chat_completions = "$UPSTREAM/mixed/v1"
[models.chat-only]
label = "Chat Only"
[models.spare-chat]
label = "Spare Chat"
[models.twin]
label = "Twin"
[routes.mixed-chat]
account = "mixed"
model = "chat-only"
upstream_model = "chat-only"
interfaces = { openai_chat_completions = [] }
[routes.mixed-spare]
account = "mixed"
model = "spare-chat"
upstream_model = "spare-chat"
interfaces = { openai_chat_completions = [] }
[routes.mixed-twin-chat]
account = "mixed"
model = "twin"
upstream_model = "twin"
interfaces = { openai_chat_completions = [] }
[routes.mixed-twin-messages]
account = "mixed"
model = "twin"
upstream_model = "twin"
interfaces = { anthropic = [] }
-- help.txt --
AIGW  aigw model
────────────────────────────────────────
  List, search, show, add, edit and remove models

Usage
  aigw model [command]

Commands
  add                  Add a model that a provider serves; selects it for no client
  edit                 Change a model's protocols, family, capabilities or label
  list                 List the models you have added; reads no Token and sends no request
  remove               Remove a model that no client uses; its provider and Token stay
  search               Search what providers offer, from their authenticated catalogs
  show                 Show one model: its protocols, capabilities and the clients that use it

Options
  -h, --help   help for model
-- add-help.txt --
AIGW  aigw model add
────────────────────────────────────────
  Add a model that a provider serves; selects it for no client.
  AIGW first reads the provider's catalog and adds only a model that it lists; --unlisted skips that check.

Usage
  aigw model add <provider/model> [flags]

Examples
  aigw model add dmxapi/gpt-6.2
  aigw model add ucloud/minimax-m3 --protocol anthropic --capability tool_search
  aigw model add dmxapi/gpt-6.1-sol-cdx --family gpt-6.1-sol --dry-run

Options
      --capability capability   A qualified capability; repeatable: text, reasoning, streaming, tools, structured_output, continuation, compaction, multimodal_input, tool_search
      --dry-run                 Show the addition without reading the catalog or writing anything
      --family string           The model's family; an unknown family is created
  -h, --help                    help for add
      --json                    Write the added model as JSON
      --label string            Display name
      --protocol string         The protocol on which AIGW may use the model; optional when the provider has one endpoint: anthropic, responses, or chat
      --unlisted                Add the model without reading the provider's catalog
-- list.txt --
AIGW  Models
────────────────────────────────────────

Mixed
  · mixed/twin         Mixed · Twin · Anthropic Messages, OpenAI Chat Completions · one model per protocol
  · mixed/chat-only    Mixed · Chat Only · OpenAI Chat Completions
  · mixed/spare-chat   Mixed · Spare Chat · OpenAI Chat Completions

Team Gateway
  ✓ team/team-model    Team Gateway · Anthropic Messages · used by Claude

Next
  aigw use <client> <provider/model>
