# doctor reports an incomplete setup as a failure, then the connected
# configuration's local diagnostics, as JSON and in text.
exec aigw doctor --help
cmp stdout help.txt

exitcode 1 aigw doctor
cmp stdout empty.txt
exitcode 1 aigw doctor --json
cmp stdout empty.json

stdin token.txt
exec aigw add team --label 'Team Gateway' --anthropic-url $UPSTREAM --model team-model --for claude --token-stdin
exec aigw doctor --json
cmp stdout connected.json
exec aigw doctor
normalize stdout connected.out
cmp connected.out connected.txt

-- token.txt --
sk-team-token-0001
-- help.txt --
