# config prints its path, exports a configuration that a team file set up as
# a team file without clients, and rolls back the last change; setup refuses a
# malformed team file.
exec aigw config --help
cmp stdout help.txt
exec aigw config export --help
cmp stdout export-help.txt
exec aigw config rollback --help
cmp stdout rollback-help.txt

# A home without a configuration has nothing to roll back, and the fix,
# setup, leaves nothing to roll back either.
exitcode 1 aigw config rollback
cmp stdout rollback-empty.txt
exitcode 1 aigw config rollback --json
cp stdout rollback-empty.json

exec aigw config path
normalize stdout path.out
[darwin] cmp path.out path-darwin.txt
[linux] cmp path.out path-linux.txt
[windows] cmp path.out path-windows.txt

envsubst manifest.in manifest.toml
exec aigw setup --from manifest.toml --json
fixloop -input -did 'applied a team file with aigw setup --from' rollback-empty.json aigw config rollback --json

exec aigw config export
normalize stdout export.out
cmp export.out export.toml

# A client's selection stays local: the team file names no client.
stdin token.txt
exec aigw provider rotate team --token-stdin
exec aigw use claude team/team-model
exec aigw config export
! stdout 'claude'
! stdout '\[clients'

# Rolling back the last change, the selection, restores the configuration
# before it. A preview names the source and writes nothing.
snapshot $HOME rollback-before.txt
exec aigw config rollback --last-change --dry-run
normalize stdout rollback-preview.out
[!windows] cmp rollback-preview.out rollback-preview.txt
[windows] cmp rollback-preview.out rollback-preview-windows.txt
exec aigw config rollback --last-change --dry-run --json
normalize stdout rollback-preview-json.out
cmp rollback-preview-json.out rollback-preview.json
snapshot $HOME rollback-after.txt
cmp rollback-after.txt rollback-before.txt
exec aigw config rollback --last-change --json
cmp stdout rollback-restored.json
exec aigw status --json
stdout '"claude": \{\n\s+"state": "deferred",\n\s+"detail": "No model is selected"'
exitcode 1 aigw config rollback extra --json
cmp stdout rollback-refusal.json
fixloop -input stdout aigw config rollback extra --json

exitcode 1 aigw setup --from broken.toml
cmp stdout refusal.txt
exitcode 1 aigw setup --from broken.toml --json
cmp stdout refusal.json
cp manifest.toml broken.toml
fixloop -did 'corrected the document with the team file that setup applied above' refusal.json aigw setup --from broken.toml --json

exec aigw config path --json
normalize stdout path-json.out
[darwin] cmp path-json.out path-darwin.json
[linux] cmp path-json.out path-linux.json
[windows] cmp path-json.out path-windows.json
exitcode 1 aigw config path extra --json
cmp stdout path-refusal.json
fixloop -input stdout aigw config path extra --json

-- manifest.in --
version = 8

[[providers]]
id = "team"
label = "Team Gateway"
endpoints = {anthropic = "$UPSTREAM"}

[[providers.models]]
id = "team-model"
family = "team-model"
label = "Team Route"
protocols = {anthropic = ["text"]}

[[families]]
id = "team-model"
label = "Team Model"
-- broken.toml --
version = 8
[providers
-- help.txt --
AIGW  aigw config
────────────────────────────────────────
  Show, export and roll back the configuration

Usage
  aigw config [command]

Commands
  export               Write the configuration as a secret-free team file, without clients
  path                 Print the local configuration path
  rollback             Restore the configuration and client files, not the program

Options
  -h, --help[=true|false]   help for config
-- path-darwin.txt --
$HOME/Library/Application Support/aigw/aigw.toml
-- path-linux.txt --
$HOME/aigw/aigw.toml
-- export.toml --
version = 8

[[providers]]
id = 'team'
label = 'Team Gateway'
endpoints = {anthropic = '$UPSTREAM'}

[[providers.models]]
id = 'team-model'
family = 'team-model'
label = 'Team Route'
protocols = {anthropic = ['text']}

[[families]]
id = 'team-model'
label = 'Team Model'
-- refusal.txt --
AIGW  Action required
────────────────────────────────────────

Problem
  Cannot decode TOML document at line 2, column 11

Fix
  Correct the value at the reported document location and rerun the command.
-- refusal.json --
{
  "schema_version": 3,
  "ok": false,
  "error": "Cannot decode TOML document at line 2, column 11",
  "next_detail": "Correct the value at the reported document location and rerun the command."
}
-- path-windows.txt --
$HOME\aigw\aigw.toml
-- path-darwin.json --
{
  "schema_version": 1,
  "ok": true,
  "path": "$HOME/Library/Application Support/aigw/aigw.toml"
}
-- path-refusal.json --
{
  "schema_version": 3,
  "ok": false,
  "error": "unknown command \"extra\"",
  "next_action": "aigw config path --help"
}
-- path-linux.json --
{
  "schema_version": 1,
  "ok": true,
  "path": "$HOME/aigw/aigw.toml"
}
-- path-windows.json --
{
  "schema_version": 1,
  "ok": true,
  "path": "$HOME\\aigw\\aigw.toml"
}
-- export-help.txt --
AIGW  aigw config export
────────────────────────────────────────
  Write the configuration as a secret-free team file, without clients

Usage
  aigw config export [flags]

Examples
  aigw config export
  aigw config export > team.toml

Options
  -h, --help[=true|false]   help for export
-- rollback-help.txt --
AIGW  aigw config rollback
────────────────────────────────────────
  Restore the configuration and the client files from the latest fully
  verified snapshot, or else from the previous backup. --last-change
  selects only that backup. This does not replace the AIGW program.

Usage
  aigw config rollback [flags]

Examples
  aigw config rollback --dry-run
  aigw config rollback
  aigw config rollback --last-change --json

Options
      --dry-run[=true|false]       Show the source and the client files that a rollback would restore without writing them
  -h, --help[=true|false]          help for rollback
      --json[=true|false]          Write the restore source as JSON
      --last-change[=true|false]   Restore only the previous configuration backup
-- rollback-empty.txt --
AIGW  Action required
────────────────────────────────────────

Problem
  Configuration rollback is unavailable

Evidence
  No valid recovery source is available for the current configuration.

Impact
  The current configuration remains active and unchanged.

Fix
  aigw setup
-- rollback-preview.txt --
AIGW  Rollback preview
────────────────────────────────────────

Restore source
  Configuration        Previous configuration

Client files
  $HOME/.claude/settings.json  restore
  ✓ Preview did not write configuration, credentials or client files

Next
  aigw config rollback --last-change
-- rollback-preview.json --
{
  "schema_version": 2,
  "ok": true,
  "dry_run": true,
  "source": "previous_backup",
  "client_files": [
    {
      "client": "claude",
      "file": "~/.claude/settings.json",
      "action": "restore"
    }
  ],
  "next_action": "aigw config rollback --last-change"
}
-- rollback-restored.json --
{
  "schema_version": 2,
  "ok": true,
  "source": "previous_backup",
  "next_action": "aigw check --depth local"
}
-- rollback-refusal.json --
{
  "schema_version": 3,
  "ok": false,
  "error": "unknown command \"extra\"",
  "next_action": "aigw config rollback --help"
}
-- token.txt --
sk-team-token-0001
-- rollback-preview-windows.txt --
