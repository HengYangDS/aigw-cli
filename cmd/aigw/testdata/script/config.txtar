# config prints its path, imports a manifest as JSON, exports the merged
# configuration as a team file without clients, rolls back the last change,
# previews a migration, and refuses a malformed manifest.
exec aigw config --help
cmp stdout help.txt
exec aigw config export --help
cmp stdout export-help.txt
exec aigw config rollback --help
cmp stdout rollback-help.txt

# A home without a configuration has nothing to roll back, and the fix,
# setup, leaves nothing to roll back either.
exitcode 1 aigw config rollback
cmp stdout rollback-empty.txt
exitcode 1 aigw config rollback --json
cp stdout rollback-empty.json

exec aigw config path
normalize stdout path.out
[darwin] cmp path.out path-darwin.txt
[linux] cmp path.out path-linux.txt
[windows] cmp path.out path-windows.txt

envsubst manifest.in manifest.toml
snapshot $HOME before.txt
exec aigw config import manifest.toml --dry-run --json
cmp stdout import-preview.json
snapshot $HOME after.txt
cmp after.txt before.txt
exec aigw config import manifest.toml --json
cmp stdout imported.json
fixloop -input -did 'imported a team file, as setup does' rollback-empty.json aigw config rollback --json
exec aigw config export
normalize stdout export.out
cmp export.out export.toml

# A client's selection stays local: the team file names no client.
stdin token.txt
exec aigw provider rotate team --token-stdin
exec aigw use claude team/team-model
exec aigw config export
! stdout 'claude'
! stdout '\[clients'

# Rolling back the last change, the selection, restores the configuration
# before it. A preview names the source and writes nothing.
snapshot $HOME rollback-before.txt
exec aigw config rollback --last-change --dry-run
normalize stdout rollback-preview.out
[!windows] cmp rollback-preview.out rollback-preview.txt
[windows] cmp rollback-preview.out rollback-preview-windows.txt
exec aigw config rollback --last-change --dry-run --json
normalize stdout rollback-preview-json.out
cmp rollback-preview-json.out rollback-preview.json
snapshot $HOME rollback-after.txt
cmp rollback-after.txt rollback-before.txt
exec aigw config rollback --last-change --json
cmp stdout rollback-restored.json
exec aigw status --json
stdout '"claude": \{\n\s+"state": "deferred",\n\s+"detail": "No model is selected"'
exitcode 1 aigw config rollback extra --json
cmp stdout rollback-refusal.json
fixloop -input stdout aigw config rollback extra --json

exitcode 1 aigw config import broken.toml
cmp stdout refusal.txt
exitcode 1 aigw config import broken.toml --json
cmp stdout refusal.json
cp manifest.toml broken.toml
fixloop -did 'corrected the document with the manifest that imported above' refusal.json aigw config import broken.toml --json
snapshot $HOME migrate-before.txt
exec aigw config migrate --dry-run --json
normalize stdout migrate.out
cmp migrate.out migrate.json
snapshot $HOME migrate-after.txt
cmp migrate-after.txt migrate-before.txt
exitcode 1 aigw config migrate extra --json
cmp stdout migrate-refusal.json
fixloop -input stdout aigw config migrate extra --json

exec aigw config path --json
normalize stdout path-json.out
[darwin] cmp path-json.out path-darwin.json
[linux] cmp path-json.out path-linux.json
[windows] cmp path-json.out path-windows.json
exitcode 1 aigw config path extra --json
cmp stdout path-refusal.json
fixloop -input stdout aigw config path extra --json

-- import-preview.json --
{
  "schema_version": 2,
  "ok": true,
  "dry_run": true,
  "imported_accounts": 1,
  "imported_routes": 1,
  "next_action": "aigw config import manifest.toml"
}
-- manifest.in --
version = 7
[accounts.team]
label = "Team Gateway"
[accounts.team.endpoints]
anthropic = "$UPSTREAM"
[models.team-model]
label = "Team Model"
[routes.team-route]
label = "Team Route"
account = "team"
model = "team-model"
upstream_model = "team-model"
interfaces = { anthropic = ["text"] }
-- broken.toml --
version = 7
[accounts.team
-- help.txt --
AIGW  aigw config
────────────────────────────────────────
  Show, export and roll back the configuration

Usage
  aigw config [command]

Commands
  export               Write the configuration as a secret-free team file, without clients
  import               Merge a secret-free configuration manifest
  migrate              Migrate retained local configuration to or from the current schema
  path                 Print the local configuration path
  rollback             Restore the configuration and client files, not the program

Options
  -h, --help   help for config
-- path-darwin.txt --
$HOME/Library/Application Support/aigw/config.toml
-- path-linux.txt --
$HOME/aigw/config.toml
-- imported.json --
{
  "schema_version": 2,
  "ok": true,
  "imported_accounts": 1,
  "imported_routes": 1,
  "next_action": "aigw status"
}
-- export.toml --
version = 7

[accounts]
[accounts.team]
label = 'Team Gateway'

[accounts.team.endpoints]
anthropic = '$UPSTREAM'

[models]
[models.team-model]
label = 'Team Model'

[routes]
[routes.team-route]
label = 'Team Route'
account = 'team'
model = 'team-model'
upstream_model = 'team-model'

[routes.team-route.interfaces]
anthropic = ['text']
-- refusal.txt --
AIGW  Action required
────────────────────────────────────────

Problem
  Cannot decode TOML document at line 2, column 15

Fix
  Correct the value at the reported document location and rerun the command.
-- refusal.json --
{
  "schema_version": 3,
  "ok": false,
  "error": "Cannot decode TOML document at line 2, column 15",
  "next_detail": "Correct the value at the reported document location and rerun the command."
}
-- path-windows.txt --
$HOME\aigw\config.toml
-- path-darwin.json --
{
  "schema_version": 1,
  "ok": true,
  "path": "$HOME/Library/Application Support/aigw/config.toml"
}
-- path-refusal.json --
{
  "schema_version": 3,
  "ok": false,
  "error": "unknown command \"extra\"",
  "next_action": "aigw config path --help"
}
-- path-linux.json --
{
  "schema_version": 1,
  "ok": true,
  "path": "$HOME/aigw/config.toml"
}
-- path-windows.json --
{
  "schema_version": 1,
  "ok": true,
  "path": "$HOME\\aigw\\config.toml"
}
