# config prints its path, imports a manifest as JSON, exports the merged
# configuration, previews a migration, and refuses a malformed manifest.
exec aigw config --help
cmp stdout help.txt

exec aigw config path
normalize stdout path.out
[darwin] cmp path.out path-darwin.txt
[linux] cmp path.out path-linux.txt
[windows] cmp path.out path-windows.txt

envsubst manifest.in manifest.toml
snapshot $HOME before.txt
exec aigw config import manifest.toml --dry-run --json
cmp stdout import-preview.json
snapshot $HOME after.txt
cmp after.txt before.txt
exec aigw config import manifest.toml --json
cmp stdout imported.json
exec aigw config export
normalize stdout export.out
cmp export.out export.toml

exitcode 1 aigw config import broken.toml
cmp stdout refusal.txt
exitcode 1 aigw config import broken.toml --json
cmp stdout refusal.json
snapshot $HOME migrate-before.txt
exec aigw config migrate --dry-run --json
normalize stdout migrate.out
cmp migrate.out migrate.json
snapshot $HOME migrate-after.txt
cmp migrate-after.txt migrate-before.txt
exitcode 1 aigw config migrate extra --json
cmp stdout migrate-refusal.json

exec aigw config path --json
normalize stdout path-json.out
[darwin] cmp path-json.out path-darwin.json
[linux] cmp path-json.out path-linux.json
[windows] cmp path-json.out path-windows.json
exitcode 1 aigw config path extra --json
cmp stdout path-refusal.json

-- import-preview.json --
{
  "schema_version": 2,
  "ok": true,
  "dry_run": true,
  "imported_accounts": 1,
  "imported_routes": 1,
  "next_action": "aigw config import manifest.toml"
}
-- manifest.in --
version = 7
[accounts.team]
label = "Team Gateway"
[accounts.team.endpoints]
anthropic = "$UPSTREAM"
[models.team-model]
label = "Team Model"
[routes.team-route]
label = "Team Route"
account = "team"
model = "team-model"
upstream_model = "team-model"
interfaces = { anthropic = ["text"] }
-- broken.toml --
version = 7
[accounts.team
-- help.txt --
AIGW  aigw config
────────────────────────────────────────
  Import and export configuration

Usage
  aigw config [command]

Commands
  export               Export a secret-free configuration manifest
  import               Merge a secret-free configuration manifest
  migrate              Migrate retained local configuration to or from the current schema
  path                 Print the local configuration path

Options
  -h, --help   help for config
-- path-darwin.txt --
$HOME/Library/Application Support/aigw/config.toml
-- path-linux.txt --
$HOME/aigw/config.toml
-- imported.json --
{
  "schema_version": 2,
  "ok": true,
  "imported_accounts": 1,
  "imported_routes": 1,
  "next_action": "aigw status"
}
-- export.toml --
version = 7

[accounts]
[accounts.team]
label = 'Team Gateway'

[accounts.team.endpoints]
anthropic = '$UPSTREAM'

[models]
[models.team-model]
label = 'Team Model'

[routes]
[routes.team-route]
label = 'Team Route'
account = 'team'
model = 'team-model'
upstream_model = 'team-model'

[routes.team-route.interfaces]
anthropic = ['text']
-- refusal.txt --
AIGW  Action required
────────────────────────────────────────

Problem
  Cannot decode TOML document at line 2, column 15

Impact
  The command could not finish; inspect current state before retrying.

Recommended action
  Correct the value at the reported document location and rerun the command.
-- refusal.json --
{
  "schema_version": 2,
  "ok": false,
  "error": "Cannot decode TOML document at line 2, column 15",
  "impact": "The command could not finish; inspect current state before retrying.",
  "next_detail": "Correct the value at the reported document location and rerun the command."
}
-- path-windows.txt --
$HOME\aigw\config.toml
-- path-darwin.json --
{
  "schema_version": 1,
  "ok": true,
  "path": "$HOME/Library/Application Support/aigw/config.toml"
}
-- path-refusal.json --
{
  "schema_version": 2,
  "ok": false,
  "error": "unknown command \"extra\"",
  "impact": "The command could not finish; inspect current state before retrying.",
  "next_action": "aigw --help"
}
-- path-linux.json --
{
  "schema_version": 1,
  "ok": true,
  "path": "$HOME/aigw/config.toml"
}
-- path-windows.json --
{
  "schema_version": 1,
  "ok": true,
  "path": "$HOME\\aigw\\config.toml"
}
-- migrate.json --
{
  "schema_version": 2,
  "ok": true,
  "dry_run": true,
  "required": false,
  "direction": "upgrade",
  "from_version": 6,
  "to_version": 6,
  "accounts": [
    "team"
  ],
  "routes": [
    "team-route"
  ],
  "clients": {},
  "recommendations": {},
  "next_action": "aigw check"
}
-- migrate-refusal.json --
{
  "schema_version": 2,
  "ok": false,
  "error": "unknown command \"extra\"",
  "impact": "The command could not finish; inspect current state before retrying.",
  "next_action": "aigw --help"
}
