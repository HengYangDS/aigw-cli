#!/bin/sh
set -eu

if [ "$(id -u)" -ne 0 ]; then
  echo "AIGW native uninstall must run as root" >&2
  exit 2
fi

target=${1:-/}
case "$target" in
  /) ;;
  /*) ;;
  *)
    echo "AIGW native uninstall target must be an absolute volume path" >&2
    exit 2
    ;;
esac

prefix=${target%/}/usr/local
binary="$prefix/bin/aigw"
uninstaller="$prefix/libexec/aigw/uninstall"
# The package owns only usr/local/bin/aigw and usr/local/libexec/aigw/uninstall.

rm -f "$binary" "$uninstaller"
rmdir "$prefix/libexec/aigw" 2>/dev/null || true
rmdir "$prefix/libexec" 2>/dev/null || true

if [ "$target" != / ] && command -v pkgutil >/dev/null 2>&1; then
  pkgutil --volume "$target" --forget dig.aigw.cli >/dev/null 2>&1 || true
elif command -v pkgutil >/dev/null 2>&1; then
  pkgutil --forget dig.aigw.cli >/dev/null 2>&1 || true
fi

echo "AIGW native package files removed from $target"
