  "questions": {
    "overview": {
      "audience": "operator",
      "prompt": "How does explicit intent become a bounded native client projection?",
      "claims": [
        "operator-cli",
        "cli-configuration",
        "configuration-accounts",
        "configuration-profiles",
        "configuration-synchronizer",
        "synchronizer-registry",
        "registry-adapter",
        "adapter-credentials",
        "adapter-transaction",
        "adapter-clients"
      ],
      "detail": "overview",
      "risk": "Omission would hide an authority or effect boundary."
    },
    "state": {
      "audience": "maintainer",
      "prompt": "Which state carries provider, route and client intent?",
      "claims": [
        "cli-configuration",
        "configuration-accounts",
        "configuration-profiles",
        "configuration-synchronizer"
      ],
      "detail": "mechanism",
      "risk": "Omission would confuse desired state with generated projections."
    },
    "projection": {
      "audience": "maintainer",
      "prompt": "How are enabled clients selected and projected?",
      "claims": [
        "synchronizer-registry",
        "registry-adapter",
        "adapter-clients"
      ],
      "detail": "mechanism",
      "risk": "Omission would hide registry order and adapter ownership."
    },
    "safety": {
      "audience": "operator",
      "prompt": "Where are credentials and mutation safety bounded?",
      "claims": ["adapter-credentials", "adapter-transaction"],
      "detail": "mechanism",
      "risk": "Omission would hide the credential and compensation boundaries."
    }
  },
